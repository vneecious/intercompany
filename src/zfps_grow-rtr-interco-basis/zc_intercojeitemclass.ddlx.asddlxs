@Metadata.layer: #CORE

@UI.headerInfo: {
    typeName: '{@i18n>TypeName}',
    typeNamePlural: '{@i18n>TypeNamePlural}',
    title: {
        type: #STANDARD,
        label: '{@i18n>appTitle}'
    },
    description: {
        type: #STANDARD,
        label: '{@i18n>appDescription}'
    }
}

@UI.presentationVariant: [{
    sortOrder: [{ by: 'CompanyCode', direction: #ASC },
    { by: 'GLAccount', direction: #ASC },
    { by: 'AccountingDocument', direction: #ASC },
    { by: 'LedgerGLLineItem', direction: #ASC }],
    groupBy: [ 'GLAccount', 'CostCenter', 'ProfitCenter', 'IsBillable'],
    totalBy: [ 'GLAccount', 'CostCenter', 'ProfitCenter', 'IsBillable'],
    includeGrandTotal: true,
    requestAtLeast: [ 'GLAccount', 'ProfitCenter', 'CostCenter', 'IsBillableCriticality'],
    visualizations: [{
        type: #AS_LINEITEM
    }]
}]
