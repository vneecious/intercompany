CLASS zcl_interco_cph_data_load DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.

    INTERFACES if_oo_adt_classrun .

    TYPES:
      ty_cph  TYPE STANDARD TABLE OF zfi_a_intrc_cph .

    CLASS-METHODS clean_table
