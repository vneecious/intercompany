  METHOD delete_relatedproposal.
    DELETE FROM zfi_a_intrc_cpbg WHERE id EQ @i_UUID.
    DELETE FROM zfi_a_intrc_cpid WHERE id EQ @i_UUID.
    DELETE FROM zfi_a_intrc_cpic WHERE id EQ @i_UUID.
    DELETE FROM zfi_a_intrc_cpib WHERE id EQ @i_UUID.
    DELETE FROM zfi_a_intrc_cpd WHERE id EQ @i_UUID.
    DELETE FROM zfi_a_intrc_cpdl WHERE id EQ @i_UUID.
    UPDATE zfi_a_intrc_cph SET isdeleted = @abap_false, status = @space WHERE id EQ @i_UUID.
    COMMIT WORK.
  ENDMETHOD.

  METHOD load_data.
    DATA: lt_cph        TYPE ty_cph,
          lv_valid_from TYPE sy-datum,
          lv_valid_to   TYPE sy-datum,
          lv_timestamp  TYPE timestampl,
          system_uuid   TYPE REF TO if_system_uuid,
          lv_uuid       TYPE sysuuid_c32.

    lt_cph = it_cph.
    system_uuid = cl_uuid_factory=>create_system_uuid( ).
    lv_valid_from = sy-datum.
    lv_valid_to = '99991231'.
    GET TIME STAMP FIELD lv_timestamp.


    LOOP AT lt_cph ASSIGNING FIELD-SYMBOL(<ls_cph>).
      lv_uuid = system_uuid->create_uuid_c32( ).

*      <ls_cph>-id = lv_uuid.
      <ls_cph>-intercobasisid = system_uuid->create_uuid_c32( ).
      <ls_cph>-isdeleted = abap_false.
      <ls_cph>-createdat = lv_timestamp.
      <ls_cph>-createdby = sy-uname.
    ENDLOOP.

    MODIFY zfi_a_intrc_cph FROM TABLE @lt_cph.
    COMMIT WORK.

    rv_len = lines( lt_cph ).
  ENDMETHOD.


  METHOD if_oo_adt_classrun~main.
    DATA: lt_cph      TYPE STANDARD TABLE OF zfi_a_intrc_cph.
    CASE sy-sysid.
      WHEN 'DS4'.
        APPEND VALUE #( fiscalperiod = '012' fiscalyear = '2024' providercompanycode = 'DRM' product = 'Z-PUB001'           status = 'T' globalcurrency = 'USD' amountinglobalcurrency = '100.00' ) TO lt_cph.
        APPEND VALUE #( fiscalperiod = '003' fiscalyear = '2024' providercompanycode = 'DRM' product = '000000000000010020' status = 'T' globalcurrency = 'USD' amountinglobalcurrency = '200.00' ) TO lt_cph.
        APPEND VALUE #( fiscalperiod = '003' fiscalyear = '2024' providercompanycode = 'EBA' product = '000000000000000000' status = 'T' globalcurrency = 'USD' amountinglobalcurrency = '300.00' ) TO lt_cph.
        APPEND VALUE #( fiscalperiod = '003' fiscalyear = '2024' providercompanycode = 'FLA' product = '000000000000000025' status = 'T' globalcurrency = 'USD' amountinglobalcurrency = '400.00' ) TO lt_cph.
        APPEND VALUE #( fiscalperiod = '012' fiscalyear = '2024' providercompanycode = 'FLA' product = '000000000000000024' status = 'T' globalcurrency = 'USD' amountinglobalcurrency = '100.00' ) TO lt_cph.
        APPEND VALUE #( fiscalperiod = '003' fiscalyear = '2024' providercompanycode = 'FLA' product = '000000000000000030' status = 'T' globalcurrency = 'USD' amountinglobalcurrency = '200.00' ) TO lt_cph.
