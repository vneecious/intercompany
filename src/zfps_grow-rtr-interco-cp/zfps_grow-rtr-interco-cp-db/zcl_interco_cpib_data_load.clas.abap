*      APPEND VALUE #( id = <ls_cpi>-id item_id = <ls_cpi>-item_id itembasis_id = '6' metric_id = '3' sharedrate = 3 globalcurrency = 'USD' amountinglobalcurrency = '9999.99' companycodecurrency = 'PEN' amountincompanycodecurrency = '1111.11' )
