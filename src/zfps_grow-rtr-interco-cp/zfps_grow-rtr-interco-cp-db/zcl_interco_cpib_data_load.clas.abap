CLASS zcl_interco_cpib_data_load DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun .

    TYPES:
      ty_cpib  TYPE STANDARD TABLE OF zfi_a_intrc_cpib,
      ty_cpig  TYPE STANDARD TABLE OF zfi_a_intrc_cpig,
      ty_cpbg  TYPE STANDARD TABLE OF zfi_a_intrc_cpbg .

    CLASS-METHODS clean_table .
    CLASS-METHODS load_data
      IMPORTING
        !it_cpib      TYPE ty_cpib
      RETURNING
        VALUE(rv_len) TYPE int4 .
  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.



CLASS zcl_interco_cpib_data_load IMPLEMENTATION.
  METHOD clean_table.
    DELETE FROM zfi_a_intrc_cpib WHERE id IS NOT INITIAL.
    COMMIT WORK.
  ENDMETHOD.

  METHOD load_data.
    DATA: lt_cpib       TYPE ty_cpib,
          lv_valid_from TYPE sy-datum,
          lv_valid_to   TYPE sy-datum,
          lv_timestamp  TYPE timestampl,
          system_uuid   TYPE REF TO if_system_uuid,
          lv_uuid       TYPE sysuuid_c32,
          lt_cpig       TYPE ty_cpig,
          lt_cpbg       TYPE ty_cpbg.

    lt_cpib = it_cpib.
    system_uuid = cl_uuid_factory=>create_system_uuid( ).
    lv_valid_from = sy-datum.
    lv_valid_to = '99991231'.
    GET TIME STAMP FIELD lv_timestamp.

    SELECT id, item_id FROM zfi_a_intrc_cpi
    WHERE id IS NOT INITIAL
    INTO TABLE @DATA(lt_cpi)." up to 100 rows.
*    SELECT SINGLE id, item_id FROM zfi_a_intrc_cpi INTO @DATA(ls_cph).

    LOOP AT lt_cpi ASSIGNING FIELD-SYMBOL(<ls_cpi>).
      "lv_uuid = system_uuid->create_uuid_c32( ).
*      ls_cpib-id = <ls_cpi>-id.
*      ls_cpib-item_id = <ls_cpi>-item_id.
      APPEND VALUE #( id = <ls_cpi>-id item_id = <ls_cpi>-item_id itembasis_id = '1' metric_id = '1' sharedrate = '3.124412' globalcurrency = 'USD' amountinglobalcurrency = '22925.19' companycodecurrency = 'USD' amountincompanycodecurrency = '22925.19' )
      TO lt_cpib.
      IF sy-tabix <= 10.
        APPEND VALUE #( id = <ls_cpi>-id item_id = <ls_cpi>-item_id itembasis_id = '2' metric_id = '1' sharedrate = 3 globalcurrency = 'USD' amountinglobalcurrency = '9999.99' companycodecurrency = 'PEN' amountincompanycodecurrency = '1111.11' )
        TO lt_cpib.
      ENDIF.
      IF sy-tabix >= 5 AND sy-tabix <= 10.
        APPEND VALUE #( id = <ls_cpi>-id item_id = <ls_cpi>-item_id itembasis_id = '3' metric_id = '1' sharedrate = 3 globalcurrency = 'USD' amountinglobalcurrency = '123.33' companycodecurrency = 'PEN' amountincompanycodecurrency = '155.99' )
        TO lt_cpib.
      ENDIF.
*      APPEND VALUE #( id = <ls_cpi>-id item_id = <ls_cpi>-item_id itembasis_id = '4' metric_id = '2' sharedrate = 3 globalcurrency = 'USD' amountinglobalcurrency = '9999.99' companycodecurrency = 'PEN' amountincompanycodecurrency = '1111.11' )
