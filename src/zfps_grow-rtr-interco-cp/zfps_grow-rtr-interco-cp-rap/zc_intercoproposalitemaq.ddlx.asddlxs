  GUpPAmountInCompCurr;

  @UI: { lineItem: [ { position: 310 } ] }
  @EndUserText.label: 'Total in Global Amount'
  TotalInGlobalAmount;

  @UI: { lineItem: [ { position: 320 } ] }
  @EndUserText.label: 'Total in Company Code Amount'
  TotalInCompanyCodeAmount;

