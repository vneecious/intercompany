  @UI: { hidden: false }
  @EndUserText.label: 'Profit Center Name'
  ProfitCenterName;

  @UI: { lineItem: [ { position: 60 } ],identification:[ { position: 60 } ]}
  @EndUserText.label: 'Interdivisional'
