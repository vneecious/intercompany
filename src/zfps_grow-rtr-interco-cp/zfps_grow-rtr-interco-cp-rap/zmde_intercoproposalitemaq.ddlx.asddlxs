@Metadata.layer: #CORE
@UI: {
  headerInfo: {
        typeName: 'Item',
        typeNamePlural: 'Items',
        title: { label: 'Item ',
                 value: 'Item_Id',
                 type: #STANDARD }
  },
  textArrangement: #TEXT_LAST
  }
@UI.presentationVariant: [{requestAtLeast: ['Id','Item_Id']}]
//@UI.lineItem: [{criticality: 'StatusCriticality'}]
annotate entity ZI_INTERCOPROPOSALITEMAQ with
//annotate entity ZC_INTERCOPROPOSALITEMAQ with
{
  @UI.facet: [
  //Header Facet - Object Page
            { id: 'HAmountGlb',
              purpose: #HEADER,
              type: #DATAPOINT_REFERENCE,
              position: 10,
              targetQualifier: 'HAmountGlb'
            },
  //                { id: 'HAmountCC',
  //                  purpose: #HEADER,
  //                  type: #DATAPOINT_REFERENCE,
  //                  position: 20,
  //                  targetQualifier: 'HAmountCC'
  //                },
  //    //Body Facet ( Object Page)
  //    // Facet 1 - Parent (collection) for General Info
            {
              id: 'General',
              purpose: #STANDARD,
              type: #COLLECTION,
              label: 'General',
              position: 10 ,
              targetQualifier: 'General'
            },
            {
              id: 'BasicData',
              purpose: #STANDARD,
              type: #FIELDGROUP_REFERENCE,
              parentId: 'General',
              label: 'Basic Data',
              position: 10,
              targetQualifier: 'BasicData'
            },
  //    // Facet 2 - Base
            {
              id: 'Base',
              purpose: #STANDARD,
              type: #LINEITEM_REFERENCE,
              label: 'Base Calculation',
              position: 20 ,
              targetElement: '_ProposalItemsBasis'
            },
  //    // Facet 3 - Calc
            {
              id: 'Calculo',
              purpose: #STANDARD,
              type: #LINEITEM_REFERENCE,
              label: 'Calculation Result',
              position: 40 ,
              targetElement: '_ProposalItemsCalc'
            }
  ]

  @UI: {
      lineItem: [ {
          position: 5,
  //              label: 'Estado',
          criticality: 'StatusCriticality',
          criticalityRepresentation: #WITH_ICON
      } ],

      dataPoint: {
          qualifier: 'StatusCriticality',
  //              title: 'Estado',
          criticality: 'StatusCriticality',
          criticalityRepresentation: #WITH_ICON
      }
  }
  //  @UI.hidden: true
  @EndUserText.label: 'Status'
  Status;

  @UI.hidden: true
  @Consumption.filter.hidden: true
  StatusCriticality;

  @UI.hidden: false
  Id;

  //  @UI: { lineItem: [ { position: 10 },
  //                     { type: #FOR_ACTION, dataAction: 'ReverseItem', label: 'Anulate', inline: true }
  //                   ],
  //         identification:[ { position: 10 },
  //                          { type: #FOR_ACTION, dataAction: 'ReverseItem' , label: 'Anulate', inline: true }
  //                        ]
  //       }
  @UI: {  lineItem: [ { position: 10 } ],
          identification:[ { position: 10 } ] }
  @EndUserText.label: 'Item'
  Item_Id;

  @UI: {  lineItem: [ { position: 20 } ],
          identification:[ { position: 20 } ],
          fieldGroup: [{ qualifier: 'BasicData', position: 20 } ]}
  @EndUserText.label: 'Provider Company Code'
  ProviderCompanyCode;
  @UI: { hidden: false }
  @EndUserText.label: 'Provider Company Name'
  ProviderCompanyName;

  @UI: { lineItem: [ { position: 30 } ],identification:[ { position: 30 } ],
          fieldGroup: [{ qualifier: 'BasicData', position: 30 } ]}
  @EndUserText.label: 'Recipient Company Code'
  recipientcompanycode;
  @UI: { hidden: false }
  @EndUserText.label: 'Recipient Company Name'
  RecipientCompanyName;

  @UI: { lineItem: [ { position: 40 } ],
