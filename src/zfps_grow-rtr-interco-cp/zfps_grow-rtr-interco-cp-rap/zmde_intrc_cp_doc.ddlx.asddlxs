  @EndUserText.label: 'Concept'
  Product;
  
  @UI: { //lineItem: [ { position: 60 } ],
   hidden : true }
  @Consumption.filter.hidden: true
  @EndUserText.label: 'Concept Name'
  ProductName;
  
  @UI: { lineItem: [ { position: 80 } ]}
  @EndUserText.label: 'Parent Document Key'
  ParentDocumentKey;
  @UI: { lineItem: [ { position: 90 } ]}
  @EndUserText.label: 'Parent Document Type'
  ParentDocumentType;
  @UI: { //lineItem: [ { position: 60 } ],
