                    id: 'Base',
                    purpose: #STANDARD,
                    type: #LINEITEM_REFERENCE,
                    label: 'Logs',
                    position: 10 ,
                    targetElement: '_log'
                }
             ]
  @UI.hidden: true
  Id;
  @UI: { lineItem: [ { position: 10 } ]}
