@Metadata.layer: #CUSTOMER
@UI: {
  headerInfo: {
        typeName: 'Document Generated',
        typeNamePlural: 'Documents Generated',
        title: { label: 'Item',
                 value: 'Id',
                 type: #STANDARD }
  }
  }
@UI.lineItem: [{criticality: 'StatusCriticality'}]
annotate entity ZC_INTRC_CPD with
{
