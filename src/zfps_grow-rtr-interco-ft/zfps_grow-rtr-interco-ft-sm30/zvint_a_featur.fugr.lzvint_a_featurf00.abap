ZINT_A_FEATURE-ENABLED .
ZVINT_A_FEATURE-VALIDFROM =
ZINT_A_FEATURE-VALIDFROM .
ZVINT_A_FEATURE-CREATED_AT =
ZINT_A_FEATURE-CREATED_AT .
ZVINT_A_FEATURE-CREATED_BY =
ZINT_A_FEATURE-CREATED_BY .
ZVINT_A_FEATURE-LAST_CHANGED_AT =
ZINT_A_FEATURE-LAST_CHANGED_AT .
ZVINT_A_FEATURE-LAST_CHANGED_BY =
ZINT_A_FEATURE-LAST_CHANGED_BY .
<VIM_TOTAL_STRUC> = ZVINT_A_FEATURE.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZVINT_A_FEATURE .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZVINT_A_FEATURE.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZVINT_A_FEATURE-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZINT_A_FEATURE WHERE
  FEATURE = ZVINT_A_FEATURE-FEATURE AND
  COMPANY_CODE = ZVINT_A_FEATURE-COMPANY_CODE AND
  PRODUCT = ZVINT_A_FEATURE-PRODUCT AND
  PANDLID = ZVINT_A_FEATURE-PANDLID .
    IF SY-SUBRC = 0.
    DELETE ZINT_A_FEATURE .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZINT_A_FEATURE WHERE
  FEATURE = ZVINT_A_FEATURE-FEATURE AND
  COMPANY_CODE = ZVINT_A_FEATURE-COMPANY_CODE AND
  PRODUCT = ZVINT_A_FEATURE-PRODUCT AND
  PANDLID = ZVINT_A_FEATURE-PANDLID .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZINT_A_FEATURE.
    ENDIF.
ZINT_A_FEATURE-CLIENT =
ZVINT_A_FEATURE-CLIENT .
ZINT_A_FEATURE-FEATURE =
ZVINT_A_FEATURE-FEATURE .
ZINT_A_FEATURE-COMPANY_CODE =
ZVINT_A_FEATURE-COMPANY_CODE .
ZINT_A_FEATURE-PRODUCT =
ZVINT_A_FEATURE-PRODUCT .
ZINT_A_FEATURE-PANDLID =
ZVINT_A_FEATURE-PANDLID .
ZINT_A_FEATURE-ENABLED =
ZVINT_A_FEATURE-ENABLED .
ZINT_A_FEATURE-VALIDFROM =
ZVINT_A_FEATURE-VALIDFROM .
ZINT_A_FEATURE-CREATED_AT =
ZVINT_A_FEATURE-CREATED_AT .
ZINT_A_FEATURE-CREATED_BY =
ZVINT_A_FEATURE-CREATED_BY .
ZINT_A_FEATURE-LAST_CHANGED_AT =
ZVINT_A_FEATURE-LAST_CHANGED_AT .
ZINT_A_FEATURE-LAST_CHANGED_BY =
ZVINT_A_FEATURE-LAST_CHANGED_BY .
    IF SY-SUBRC = 0.
    UPDATE ZINT_A_FEATURE ##WARN_OK.
    ELSE.
    INSERT ZINT_A_FEATURE .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZVINT_A_FEATURE-UPD_FLAG,
STATUS_ZVINT_A_FEATURE-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
