@EndUserText.label: 'Authorizations for ZI_IntercoTaxBR'
@MappingRole: true
define role ZI_INTERCOTAXBR {
    grant 
        select
            on
                ZI_IntercoTaxBR
                    where  
                     () = aspect pfcg_auth( ZFI_IC_LVL, ACTVT = '03' ) 
                     // TEMP ->
                     or $session.user like 'FF_%'
                     or $session.user = 'EXT_FLMAJUL'
                     or $session.user = 'EXT_NEIDRODR'
                     or $session.user = 'EXT_ROMANTOV'
                     or $session.user = 'EXT_VINBARRI';
                     // TEMP <-
                     
}