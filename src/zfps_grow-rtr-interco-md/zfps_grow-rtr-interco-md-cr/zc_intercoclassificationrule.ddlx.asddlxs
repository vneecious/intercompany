  @UI: {
    // List Page
    lineItem: [{
  //        hidden: true,
        label: '{@i18n>IsNotBillable}'
    }],
    // Object Page
    identification: [{
        label: '{@i18n>IsNotBillable}'
    }],
    fieldGroup: [{ qualifier: 'SectionRuleOutput', position: 10 }]
  }
