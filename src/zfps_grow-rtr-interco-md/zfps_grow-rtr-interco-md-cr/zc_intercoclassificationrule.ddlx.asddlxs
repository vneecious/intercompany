    }],
    selectionField: [{exclude: true}],
    // Object Page
    identification: [{
        position: 50
    }],
    fieldGroup: [{ qualifier: 'Validity', position: 20 }]
  }
  ValidTo;

  @UI: {
    // List Page
  //    lineItem: [{ hidden: true }],
    // Object Page
    fieldGroup: [{ qualifier: 'SectionRuleInput', position: 10 }]
  }
  // Value Help
