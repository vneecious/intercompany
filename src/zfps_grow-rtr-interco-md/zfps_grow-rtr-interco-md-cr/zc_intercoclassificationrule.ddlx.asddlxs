@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Classification Rule',
    typeNamePlural: 'Classification Rules',
    title: {
        label: 'Classification Rule',
        value: 'RuleID'
    }
  },
/* Presentation Variant */
  presentationVariant: [{
    sortOrder: [
      { by: 'RuleID',  direction: #ASC },
      { by: 'ValidTo', direction: #DESC }
    ],
    visualizations: [{ type: #AS_LINEITEM }],
    requestAtLeast: [
      'RuleID',
      'RuleName'
    ]
   }],
  textArrangement: #TEXT_LAST
}
@Consumption.semanticObject: 'IntercoExemption'
@UI.lineItem: [{criticality: 'RuleCriticality'}]
@UI.chart: [
  {
    qualifier: 'radialScore',
    title: 'Score',
    description: 'Refleja la prioridad de la regla en superposiciones, basada en el nivel de detalle completado. A mayor cantidad de campos llenos y mayor nivel de P&L, mayor será el puntaje',
    chartType: #DONUT,
    measures: ['Score'],
    measureAttributes: [
      {
        measure: 'Score',
        role: #AXIS_1,
        asDataPoint: true
      }
    ]
  }
]
annotate view ZC_INTERCOCLASSIFICATIONRULE with
{
  /*******************************************************
   Object Page Facets
   ********************************************************/
  @UI.facet: [
        {
            id: 'GeneralInformation',
            position: 10,
            purpose: #STANDARD,
            type: #COLLECTION,
            label: '{@i18n>GeneralInformation}'
        },
        {
            id: 'HeaderFacet',
            purpose: #HEADER,
            type: #COLLECTION,
            label: '{@i18n>ClassificationRule}',
            targetQualifier: 'HeaderItems'
        },
        {
            id: 'HeaderBasicData',
            label: '{@i18n>BasicData}',
            position: 10,
