    }],
    fieldGroup: [{ qualifier: 'BasicData', position: 20 }, { qualifier: 'HeaderBasicData', position: 20 }]
  }
  RuleName;

  @UI: {
    // List Page
    lineItem: [{
        position: 40 ,
        importance: #MEDIUM
    }],
    selectionField: [{exclude: true}],
    // Object Page
    identification: [{
        position: 40
    }],
    fieldGroup: [{ qualifier: 'Validity', position: 10 }]
