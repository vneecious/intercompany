            targetQualifier: 'SectionRule'
        },
        {
            id: 'RuleInput',
            label: '{@i18n>RuleInput}',
            position: 10,
            purpose: #STANDARD,
            type: #FIELDGROUP_REFERENCE,
            targetQualifier: 'SectionRuleInput',
            parentId: 'Rule'
        },
       {
            id: 'RuleOutput',
            label: '{@i18n>RuleOutput}',
            position: 20,
            purpose: #STANDARD,
            type: #FIELDGROUP_REFERENCE,
            targetQualifier: 'SectionRuleOutput',
