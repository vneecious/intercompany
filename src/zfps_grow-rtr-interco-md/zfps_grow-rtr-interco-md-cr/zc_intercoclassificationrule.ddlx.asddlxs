        },
        {
            id: 'Logs',
            label: '{@i18n>Log}',
            importance: #HIGH,
            position: 30,
            purpose: #STANDARD,
            type: #COLLECTION
        },
        {
          type: #LINEITEM_REFERENCE,
          position: 10,
          purpose: #STANDARD,
          targetElement: '_Log',
          parentId: 'Logs'
        }]
  /*****"**************************************************
   Actions
   ********************************************************/
  @UI: {
    // List Page
    lineItem: [
        { type: #FOR_ACTION, dataAction: 'Delimit', label: '{@i18n>Delimit}', requiresContext: true },
        { type: #FOR_ACTION, dataAction: 'Delete', label: '{@i18n>Delete}', requiresContext: true, hidden: #( IsDeleted ) },
        { type: #FOR_ACTION, dataAction: 'Restore', label: '{@i18n>Restore}', requiresContext: true, hidden: #( IsNotDeleted ) }
        ],
    // Object Page
    identification: [{
        importance: #MEDIUM,
        label: '{@i18n>Delimit}',
        inline: true,
        dataAction: 'Delimit',
        requiresContext: true,
        type: #FOR_ACTION,
        hidden: #( IsDeleted ),
        position: 15 },
        {
        importance: #HIGH,
        label: '{@i18n>Delete}',
        inline: true,
        dataAction: 'Delete',
        requiresContext: true,
        type: #FOR_ACTION,
        hidden: #( IsDeleted ),
        position: 20 },
        {
        importance: #HIGH,
        label: '{@i18n>Restore}',
        inline: true,
        dataAction: 'Restore',
        requiresContext: true,
        type: #FOR_ACTION,
        hidden: #( IsNotDeleted ),
        position: 30 }]
  }

  /*******************************************************
   Fields
   ********************************************************/
  @UI.hidden: true
  ID;

  @UI: {
    // List Page
    lineItem: [{
        position: 10 ,
        importance: #HIGH
    }],
    selectionField: [{ position: 10 }],
    // Object Page
    identification: [{
        position: 10
    }],
    fieldGroup: [{ qualifier: 'BasicData', position: 10 }, { qualifier: 'HeaderBasicData', position: 10 }]
  }
  RuleID;

