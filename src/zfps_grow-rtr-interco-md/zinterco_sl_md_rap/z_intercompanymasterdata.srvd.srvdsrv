  expose ZC_INTERCOPROFITCENTEREXT    as BusinessUnitProfitCenterRelati;
  expose ZC_IntercoExemptionTP        as Exemptions;
  expose ZC_IntercoExemptionRuleTP    as ExemptionRules;
