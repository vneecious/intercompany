@EndUserText.label: 'Interco Rate values Company Rela Concept'
@MappingRole: true
define role ZDCL_INTERCOCOMPANYRELPRODRATE {
    grant 
        select
            on
                ZI_INTERCOCOMPANYRELPRODRATE
                    where
                    ( Isdeleted is initial );
