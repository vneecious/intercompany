  field ( readonly ) ProvidercompanycodeName, RecipientCompanyName, ProductName;

  determination GetProductName on modify { field Product; }
  determination GetCompanyNames on save { field Providercompanycode, Recipientcompanycode; }

  determination DeterValidFrom on modify { field ValidFrom; }
  determination DeterValidTo on modify { field validTo; }

  side effects { field ValidFrom affects $self, messages; field ValidTo affects $self, messages; }

  validation validateData on save { create; update; }

  validation validateDates on save { field Validfrom, Validto; create; update; }
  validation validateMandatory on save { field Providercompanycode, Recipientcompanycode, Validfrom, Validto; create; update; }
  validation ValidateProduct on save { field Product; create; update; }
  validation ValidateCompany on save { field Providercompanycode, Recipientcompanycode; create; update; }

  draft determine action Prepare
  {

  }

  // Ini Facturación Local CH/ARG EXT_OSCUGALD 12.11.2026 - C25-R1: mapear PaymentType a payment_type de la tabla activa
  // mapping
  //      for zint_a_md003 corresponding;
  mapping for zint_a_md003 corresponding
    {
      PaymentType = payment_type;
    }
  // Fin EXT_OSCUGALD 12.11.2026 - C25-R1
}