persistent table zint_a_md003
draft table zint_d_md003
with additional save
//with unmanaged save with full data //{ Begin ext_richroja
lock master total etag LastChangedAt
authorization master ( global, instance )
etag master LastChangedAt
{
  create;
  update;
  delete ( features : instance, precheck );

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  action ZetDelete result [1] $self;

  field ( readonly, numbering : managed ) uuid;
  field ( readonly ) Createdat, Createdby, LastChangedAt, Isdeleted;
  field ( mandatory ) Providercompanycode, Recipientcompanycode, Product, Validfrom, Validto;

  // Ini Facturación Local CH/ARG EXT_OSCUGALD 17.11.2026 - C25-R2: tipo de facturación obligatorio
  field ( mandatory ) PaymentType;
