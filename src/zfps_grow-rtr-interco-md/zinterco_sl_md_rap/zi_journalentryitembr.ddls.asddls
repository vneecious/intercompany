@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Journal Entry Item Brasil'
@Metadata.ignorePropagatedAnnotations: true
@ObjectModel.usageType:{
    serviceQuality: #X,
    sizeCategory: #XXL,
    dataClass: #MIXED
}
 
define view entity zi_journalEntryItemBR
 with parameters P_Ledger   : fins_ledger,
                 P_fiscalyear : abap.char(4)
  as select from I_JournalEntryItem as item 
  association [1..1] to ZI_IntercoCompanyCode as _company on  item.CompanyCode = _company.CompanyCode
                                                          and _company.Country               = 'BR'
