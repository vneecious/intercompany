    @UI: { lineItem: [ { position: 65 } ],identification:[ { position: 65} ]}
    @EndUserText.label: 'P&L Name'
    @UI.hidden: true
    PandLName;
 
    @UI: { lineItem: [ { position: 70 } ],identification:[ { position: 70 } ]}
    @UI.fieldGroup: [{ qualifier: 'General', position: 50 }]
    @Consumption.valueHelpDefinition: [{ entity: { name:'ZI_IntercoProfitCenter_SH', element: 'ProfitCenter' } }]
    @UI.selectionField: [{ position: 40 }]
    @EndUserText.label: 'Profit Center'
