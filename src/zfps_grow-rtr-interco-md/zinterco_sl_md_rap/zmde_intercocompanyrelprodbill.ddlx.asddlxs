    ProviderCompanyCode;
    
    @UI: { lineItem: [ { position: 55 } ],identification:[ { position: 55 } ]}
    @EndUserText.label: 'Provider Company Name'
    @UI.hidden: true
    ProviderCompanyCodeName;
    
    @UI: { lineItem: [ { position: 60 } ],identification:[ { position: 60 } ]}
    @UI.fieldGroup: [{ qualifier: 'General', position: 40 }]
    @Consumption.valueHelpDefinition: [{ entity: { name:'ZI_IntercoPandL_SH', element: 'PandLId' } }]
    @UI.selectionField: [{ position: 30 }]
    @EndUserText.label: 'P&L'
