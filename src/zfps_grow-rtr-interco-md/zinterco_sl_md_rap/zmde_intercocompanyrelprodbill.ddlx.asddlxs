    @UI: { lineItem: [ { position: 75 } ],identification:[ { position: 75 } ]}
    @EndUserText.label: 'P&Profit Center Name'
    @UI.hidden: true
    ProfitCenterName;
       
       
    @UI: { lineItem: [ { position: 80 } ],identification:[ { position: 80 } ]}
    @UI.fieldGroup: [{ qualifier: 'General', position: 60 }]
    @EndUserText.label: 'Cost Center Area'
    CostCenterArea;
    
    @UI: { lineItem: [ { position: 85 } ],identification:[ { position: 85 } ]}
    @EndUserText.label: 'Cost Center Area Name'
