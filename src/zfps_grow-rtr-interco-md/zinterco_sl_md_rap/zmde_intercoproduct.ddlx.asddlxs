        sortOrder: [
            {
                by: 'Product',
                direction: #ASC
            },
            {
                by: 'Plant',
                direction: #ASC
            },
            {
                by: 'UnitOfMeasure',
                direction: #ASC
            },
            {
                by: 'Metric',
                direction: #ASC
            }
        ],
        visualizations: [{
            type: #AS_LINEITEM
        }]
    }]
}
@UI.textArrangement: #TEXT_SEPARATE
annotate entity ZC_IntercoProduct with
{
