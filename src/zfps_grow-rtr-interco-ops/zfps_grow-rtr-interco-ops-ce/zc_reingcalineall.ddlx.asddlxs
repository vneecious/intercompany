//----------------------------------------------------------------------
// Created by     : Carlos Alexander Gonzalez Lopez (EXT_GONZALCA)
// Requirement N° :
// Date           : 07.07.2026
// Description    : Reintegro Gastos - Motor de Calculo IC - F6 Servicio+DDLX+Shell Fiori (arranque)
// Transport      : DS4K9B5XZC
// Reference      : 5000049390
//----------------------------------------------------------------------
// Change ID V003 (07.09.2026 | EXT_GONZALCA): LineStatus now carries a
// criticality reference to the new StatusCriticality field (ZI/ZC
// ...LineAll V005/V003), so rows are colour-coded by status. Same pattern
// as the DDLX of ZC_ReingCALine. StatusCriticality itself is exposed as a
// hidden column (technical support field, no fieldGroup).
// Change ID V004 (11.09.2026 | EXT_GONZALCA): column labels. Most repeated
// labels were fixed at the source -- ZREING_CA_LINE_A now has a dedicated
// data element per field instead of ZREING_CA_AMT on 9 fields and
// ZREING_PERCENT_9_6 on 4. Six columns could NOT be fixed there and are
// labelled here instead: CalcRunId and LineNum are key fields whose data
// elements are cross-app (package ...-OPS-EX, English, shared with other
// apps); BukrsPrest, BukrsRecv and Country keep the standard data elements
// because SAP forbids reusing domains BUKRS/LAND1 in a custom one
// ("El uso de Dominio BUKRS no esta permitido"); IsOrphan is a calculated
// CASE expression with no physical field. GroupKey's label changes from
// 'Cabecera' (meaningless to the end user) to 'Grupo'.
// Change ID V005 (15.09.2026 | EXT_GONZALCA): the Object Page of the CA app
// moved from CalcLine to CALineAll -- Fiori elements models cross-page
// navigation only over to-many navigation properties, and _Line is to-one,
// so list and detail now share this entity and the detail annotations have
// to live here. Frontend request of 15.09.2026, blocks A, B and D:
//  (A) UI.facet: the 8 native CollectionFacets are REPLACED by the detail
//      tree of the DDLX of ZC_ReingCALine, every target reached through the
//      _Line hop. UI.Facets is a single term per entity (no qualifier), so
//      the two trees cannot coexist; replacing was the decision taken. The
//      field groups of the native fields are kept in place, unreferenced by
//      any facet, so a future facet can point at them again at zero cost.
//      The conditional hiding of the "Origen" section is NOT implemented
//      here: @UI.facet exposes no hidden property in this release, neither
//      literal nor path-based (assessed and rejected earlier, see the
//      closing note of the DDLX of ZC_ReingCALine). The frontend resolves it
//      through the manifest, reading the new flat field HasParent
//      (ZC_ReingCALineAll V006).
//  (B) the 4 header KPIs lost in the move: dataPoints KpiBruto,
//      KpiImpuesto, KpiNetoCto and KpiNetoLocal plus their HEADER facets.
//      All 4 fields are native to CALineAll, so no _Line prefix is needed.
//      Deliberate deviation from ZC_ReingCALine, where those KPIs carry a
//      criticality: CritCriticalFix / CritPositiveFix do not exist on this
//      entity and the request did not ask for colour coding.
//  (D) multipleSelections on the 9 amount fields, so the frontend can drop
//      its local Capabilities.FilterRestrictions block and its guard.
// The list is untouched: presentationVariant, lineItem and selectionField
// keep every position and qualifier they had.
// Change ID V006 (15.09.2026 | EXT_GONZALCA): semantic row highlighting on
// the main table. Frontend request of 15.09.2026: a criticality declared for
// the LineItem TERM (not for a single DataField) makes Fiori elements paint
// the coloured bar on the left edge of every row. Annotated at ENTITY level,
// which is what emits UI.Criticality nested inside the UI.LineItem term;
// the per-cell criticality of LineStatus (V003, #WITH_ICON) is a different
// annotation and stays as it is. No new field: StatusCriticality already
// exists and stays hidden as a column.
// CAVEAT reported to Frontend: the mapping covers 8 of the 12 fixed values
// of domain ZREING_CA_LINE_STATUS. The 4 in-process ones (CALC_PROC,
// SIM_PROC, POST_PROC, ANUL_PROC) fall into the ELSE and render as 0
// (neutral), so they are visually indistinguishable from PEND. Pending a
// functional decision; changing it means touching ZI_ReingCALineAll and
// ZI_ReingCALine together, since the mapping is duplicated verbatim.
//----------------------------------------------------------------------
// CORRECTION (16.09.2026 | EXT_GONZALCA): the statement in block A of V005
// above -- "@UI.facet exposes no hidden property in this release, neither
// literal nor path-based" -- is FALSE, and so is the note it refers to at
// the end of the DDLX of ZC_ReingCALine.
// Verified against the DS4-200 compiler with a non-persistent syntax check:
// "hidden: true" (literal) and "hidden: #(HasParent)" (dynamic path) BOTH
// pass with no message. The check is not permissive -- calibrated with an
// invented property, which returns "Annotation 'UI.facet.notarealproperty'
// unknown". So the property does exist, in both forms.
// The July assessment was never run against the compiler and was propagated
// as fact into two objects. What is still NOT verified is whether $metadata
// actually emits UI.Hidden with a Path inside the facet record and whether
// SAPUI5 1.120 honours it -- that is the pending POC (point 4.1 of the
// frontend request of 16.09.2026), not a vocabulary limitation.
// HasParent stays exactly as it is: the frontend consumes it today from the
// manifest, and removing it is only on the table once that POC concludes.
//----------------------------------------------------------------------
// Change ID V007 (16.09.2026 | EXT_GONZALCA): frontend request of
// 16.09.2026, points 3.1 and 3.2.
//  (3.1) Criticality restored on 3 of the 4 header KPIs, via the two new
//        constant elements of ZC_ReingCALineAll V007: KpiImpuesto ->
//        CritCriticalFix (1, negative), KpiNetoCto and KpiNetoLocal ->
//        CritPositiveFix (3, positive). KpiBruto stays NEUTRAL on purpose:
//        there is no evidence in the previous metadata that BrutoAmt ever
//        carried a semantic colour, and the request asks to preserve the
//        old behaviour rather than invent one.
//        Note on the naming: the field is called CritCriticalFix but its
//        value is 1 (negative), NOT 2 (critical). That is what
//        ZC_ReingCALine renders today, so it is what gets reproduced here --
//        "fixing" it to 2 would be a different visual behaviour, not a fix.
//        The two fields are exposed with @UI.hidden: true, same treatment as
//        StatusCriticality. Do NOT add @UI.hiddenFilter: unsupported in this
//        on-premise release (ERR-002, see the DDLX of ZC_ReingCALine).
//  (3.2) @Consumption.filter.mandatory on PeriodYear, so the backend
//        declares the mandatory period filter and the frontend can drop its
//        local copy of the whole Capabilities.FilterRestrictions term --
//        a copy that could silently drift from the backend, which is the
//        actual reason for the request.
//        Scope, as stated in the relevamiento and agreed: this annotation is
//        a UI indication. It emits
//        Capabilities.FilterRestrictions/RequiredProperties and makes Fiori
//        elements block Go without a period; it is NOT a backend control and
//        a non-Fiori consumer can still read without a period filter.
// Both points CHANGE $metadata of ZREING_CA_SRV (binding ZREING_CA_UI_V4):
// two new properties plus the RequiredProperties entry. The frontend
// regenerates its local metadata.xml. No key, no existing field, no label
// and no list annotation is touched.
//----------------------------------------------------------------------
// Change ID V008 (17.09.2026 | EXT_GONZALCA): bug tracker #82 -- "incluir la
// busqueda de datos en el filtro de tipo de operacion". The "Tipo Operación"
// filter opened the "Definir condiciones" dialog with a free-text field: no
// list of values to pick from. OpType was the ONLY selectionField of this
// DDLX without a @Consumption.valueHelpDefinition -- its four neighbours
// (CtId, Matnr, BukrsPrest, BukrsRecv) already had one. Nothing was missing
// on the server: the annotation was simply never added.
// VH entity = ZI_ReingOpTypes, the full list of ZREING_OP_TYPES (7 values:
// AN2, ANT, D, F, NC, A, P). The other two candidates were rejected on
// purpose: ZI_ReingOpTypesVH excludes D and NC (it exists for the contract
// matchcode, T8) and calculation lines CAN legitimately be D or NC, while
// ZI_ReingOpTypesByRoleVH filters by accounting role and this filter is
// role-agnostic.
// ZREING_OP_TYPES has no language-dependent text table, so the duplicate-key
// -by-language trap that hit the StepCategory VH does not apply here.
// Package ...-OPS-EX (where the VH lives) is only READ, never modified.
// Change ID V001 (CC) - fixes-057 (25.09.2026): show OpTypeDesc as a
// separate list column and use HeaderTitle for the visual group header.
// GroupKey keeps its existing value for CA actions and its list column.
//----------------------------------------------------------------------
// Change ID V009 (17.09.2026 | EXT_GONZALCA): bug tracker #81, second half
// -- the external contract number must show up in the header of THIS Object
// Page too. fixes-038 pointed the title of the DDLX of ZC_ReingCALine at its
// own HeaderTitle element, but the Object Page the user actually reaches
// from the list report has run on CALineAll since 15.09.2026 (see V005
// above), so this header still showed GroupKey alone. Verified on TS4-400:
// title "IC-0008 MUR ICSRV45 F 001", description "SIM_ERR".
// title now points at the new HeaderTitle element of ZC_ReingCALineAll
// (V009) -- the very same grouping expression with the external contract
// number appended at the end.
// description deliberately STAYS on LineStatus: it carries the state of the
// line, which the user reads at a glance next to the title.
// GroupKey itself is untouched, so @UI.presentationVariant (groupBy and
// sortOrder) and the "Grupo" column further down render exactly as before.
// This CHANGES $metadata of ZREING_CA_SRV (binding ZREING_CA_UI_V4) by one
// new property. The frontend regenerates its local metadata.xml. No key and
// no existing field is touched.
//----------------------------------------------------------------------
// Change ID V010 (18.09.2026 | EXT_GONZALCA): ET-REING-CA-001 v50 SS9.3 --
// new "Origen del Delta" section. This file gets ONLY the two facet entries;
// the field group itself and its four fields live in the DDLX of
// ZC_ReingCALine (V005), reached here through the _Line hop like every other
// body section since V005.
// This second edit is NOT redundant, it is the whole point: the facet tree
// of this entity ENUMERATES its sections one by one (see block A of V005),
// so a field group added only on the ZC_ReingCALine side would render in
// that entity's own object page -- which nobody opens -- and stay invisible
// in the one the user actually reaches from the list report. That exact
// mistake cost a second round on bug #65 (fixes-026 -> fixes-027) and on bug
// #81 (fixes-038 -> fixes-039). Both DDLX are edited together on purpose.
// No $metadata property is added by THIS file: facets are annotations, not
// properties. The new property of the section (TotalEfectivo) comes from
// ZC_ReingCALine V005, so the frontend still regenerates metadata.xml.
//----------------------------------------------------------------------
@Metadata.layer: #CUSTOMER

// Begin Mod V009 (17.09.2026 | EXT_GONZALCA)
// Original: title: { type: #STANDARD, value: 'GroupKey' },
@UI.headerInfo: {
  typeName: 'Linea de Calculo',
  typeNamePlural: 'Lineas de Calculo',
  title: { type: #STANDARD, value: 'HeaderTitle' },
  description: { type: #STANDARD, value: 'LineStatus' }
}
// End Mod V009 (17.09.2026 | EXT_GONZALCA)

// Visual grouping by HeaderTitle (fixes-057): includes ExtContract when set.
// visualizations is mandatory —
// without it the whole PresentationVariant is ignored by the runtime.
// Only 1 grouping level applies on a responsive table (sap.m.Table), which is
// all that is needed here since groupBy has a single entry.
@UI.presentationVariant: [
  {
    groupBy: [ 'HeaderTitle' ],
    sortOrder: [ { by: 'HeaderTitle' } ],
    visualizations: [ { type: #AS_LINEITEM } ]
  }
]

// Begin Change ID V006 (15.09.2026 | EXT_GONZALCA)
// Criticality of the LineItem term as a whole -> semantic row highlighting.
// Element-level @UI.lineItem entries each emit a DataField; only the
// entity-level annotation emits the nested UI.Criticality.
@UI.lineItem: [ { criticality: 'StatusCriticality' } ]
// End Change ID V006 (15.09.2026 | EXT_GONZALCA)

annotate view ZC_ReingCALineAll with
{
  // ---- Key fields with UI relevance (CtUuid / MatUuid / OpUuid are pure
  // technical join keys — no UI annotation, per blueprint §C.3/§C.4) ----

  @UI.selectionField: [{ position: 50 }]
  @UI.lineItem:       [{ position: 60, importance: #HIGH }]
  @UI.fieldGroup:     [{ qualifier: 'Contrato', position: 50 }]
  // Begin Insert V008 (17.09.2026 | EXT_GONZALCA)
  // Bug #82: Value Help of the "Tipo Operación" filter. See the V008 note in
  // the header for why ZI_ReingOpTypes and not one of the two filtered
  // variants. Only this annotation is added -- position, lineItem and
  // fieldGroup of OpType are untouched.
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingOpTypes', element: 'OpType' } }]
  // End Insert V008 (17.09.2026 | EXT_GONZALCA)
  OpType;

  // Begin Change ID V001 (CC) - fixes-057
  @EndUserText.label: 'Desc. Tipo Operación'
  @UI.lineItem: [{ position: 65, importance: #HIGH,
                   label: 'Desc. Tipo Operación' }]
  OpTypeDesc;
  // End Change ID V001 (CC) - fixes-057

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'Soc. Receptora'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.selectionField: [{ position: 70 }]
  @UI.lineItem:       [{ position: 80, importance: #MEDIUM }]
  @UI.fieldGroup:     [{ qualifier: 'Sociedades', position: 20 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCode', element: 'CompanyCode' } }]
  BukrsRecv;

  @UI.selectionField: [{ position: 80 }]
  @UI.lineItem:       [{ position: 90, importance: #MEDIUM }]
  @UI.fieldGroup:     [{ qualifier: 'Periodo', position: 10 }]
  // Begin Insert V007 (16.09.2026 | EXT_GONZALCA)
  // Point 3.2: mandatory period filter declared in the backend. Emits
  // Capabilities.FilterRestrictions/RequiredProperties, which is what lets
  // the frontend delete its local copy of the whole term.
  @Consumption.filter.mandatory: true
  // End Insert V007 (16.09.2026 | EXT_GONZALCA)
  PeriodYear;

  @UI.selectionField: [{ position: 90 }]
  @UI.lineItem:       [{ position: 100, importance: #MEDIUM }]
  @UI.fieldGroup:     [{ qualifier: 'Periodo', position: 20 }]
  PeriodMonth;

  // ---- Non-key fields, in the exact source order of ZI_ReingCALineAll /
  // ZC_ReingCALineAll (F1) ----

  @UI.selectionField: [{ position: 20 }]
  @UI.lineItem:       [{ position: 20, importance: #MEDIUM }]
  @UI.fieldGroup:     [{ qualifier: 'Cabecera', position: 20 }]
  //Begin Insert V001 (CC) - F6 delta - Value Help para dropdown RowType (dominio ZREING_CA_ROW_TYPE)
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingCARowTypeVH', element: 'RowType' } }]
  //End Insert V001 (CC) - F6 delta
  RowType;

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'ID de Run'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.selectionField: [{ position: 10 }]
  @UI.lineItem:       [{ position: 10, importance: #HIGH }]
  @UI.fieldGroup:     [{ qualifier: 'Cabecera', position: 10 }]
  CalcRunId;

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'Nro de Linea'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.fieldGroup: [{ qualifier: 'Cabecera', position: 40 }]
  LineNum;

  @UI.selectionField: [{ position: 30 }]
  @UI.lineItem:       [{ position: 40, importance: #HIGH }]
  @UI.fieldGroup:     [{ qualifier: 'Contrato', position: 10 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingCMContractVH', element: 'CtId' } }]
  CtId;

  @UI.fieldGroup: [{ qualifier: 'Contrato', position: 20 }]
  Lifnr;

  @UI.fieldGroup: [{ qualifier: 'Contrato', position: 30 }]
  BpName;

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'Soc. Prestadora'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.selectionField: [{ position: 60 }]
  @UI.lineItem:       [{ position: 70, importance: #MEDIUM }]
  @UI.fieldGroup:     [{ qualifier: 'Sociedades', position: 10 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_CompanyCode', element: 'CompanyCode' } }]
  BukrsPrest;

  @UI.fieldGroup: [{ qualifier: 'Contrato', position: 60 }]
  OpInstanceNum;

  @UI.selectionField: [{ position: 40 }]
  @UI.lineItem:       [{ position: 50, importance: #HIGH }]
  @UI.fieldGroup:     [{ qualifier: 'Contrato', position: 40 }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingCTMatVH', element: 'Product' } }]
  Matnr;

  // Begin Change ID V001 (CC) - fixes-059
  @EndUserText.label: 'Desc. Material'
  @UI.lineItem: [{ position: 55, importance: #HIGH,
                   label: 'Desc. Material' }]
  MatDesc;
  // End Change ID V001 (CC) - fixes-059

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'Pais Receptora'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.fieldGroup: [{ qualifier: 'Contrato', position: 70 }]
  Country;

  @UI.fieldGroup: [{ qualifier: 'Shares', position: 10 }]
  SharePct;

  @UI.fieldGroup: [{ qualifier: 'Shares', position: 20 }]
  SharePaisPct;

  @UI.fieldGroup: [{ qualifier: 'Shares', position: 30 }]
  ShareCombPct;

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'Grupo'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.lineItem:   [{ position: 30, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'Cabecera', position: 30 }]
  GroupKey;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 10 }]
  @Consumption.filter.multipleSelections: true
  BaseAmt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 20 }]
  @Consumption.filter.multipleSelections: true
  CalcAmt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 30 }]
  @Consumption.filter.multipleSelections: true
  // V007 (16.09.2026): KpiBruto stays WITHOUT criticality on purpose -- see
  // point 3.1 in the header note.
  @UI.dataPoint: { qualifier: 'KpiBruto', title: 'Bruto' }
  BrutoAmt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 40 }]
  @Consumption.filter.multipleSelections: true
  GrossUpAmt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 50 }]
  @Consumption.filter.multipleSelections: true
  // Begin Mod V007 (16.09.2026 | EXT_GONZALCA)
  // Point 3.1. Original: @UI.dataPoint: { qualifier: 'KpiImpuesto', title: 'Impuesto' }
  @UI.dataPoint: { qualifier: 'KpiImpuesto', title: 'Impuesto',
                   criticality: 'CritCriticalFix' }
  // End Mod V007 (16.09.2026 | EXT_GONZALCA)
  TaxAmt;

  @UI.lineItem:   [{ position: 110, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'Montos', position: 60 }]
  @Consumption.filter.multipleSelections: true
  // Begin Mod V007 (16.09.2026 | EXT_GONZALCA)
  // Point 3.1. Original: @UI.dataPoint: { qualifier: 'KpiNetoCto', title: 'Neto Cto.' }
  @UI.dataPoint: { qualifier: 'KpiNetoCto', title: 'Neto Cto.',
                   criticality: 'CritPositiveFix' }
  // End Mod V007 (16.09.2026 | EXT_GONZALCA)
  NetAmt;

  @UI.lineItem:   [{ position: 120, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'Montos', position: 70 }]
  @Consumption.filter.multipleSelections: true
  // Begin Mod V007 (16.09.2026 | EXT_GONZALCA)
  // Point 3.1. Original: @UI.dataPoint: { qualifier: 'KpiNetoLocal', title: 'Neto Local' }
  @UI.dataPoint: { qualifier: 'KpiNetoLocal', title: 'Neto Local',
                   criticality: 'CritPositiveFix' }
  // End Mod V007 (16.09.2026 | EXT_GONZALCA)
  NetLocalAmt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 80 }]
  CtCurrency;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 90 }]
  LocalCurrency;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 100 }]
  ExchRate;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 110 }]
  ExchRateType;

  @UI.selectionField: [{ position: 100 }]
  // Begin Change ID V003 (07.09.2026 | EXT_GONZALCA)
  // criticality/criticalityRepresentation added -- same pattern as
  // LineStatus in the DDLX of ZC_ReingCALine.
  @UI.lineItem:       [{ position: 200, importance: #HIGH,
                         criticality: 'StatusCriticality',
                         criticalityRepresentation: #WITH_ICON }]
  // End Change ID V003 (07.09.2026 | EXT_GONZALCA)
  @UI.fieldGroup:     [{ qualifier: 'Estado', position: 10 }]
  //Begin Insert V001 (CC) - F6 delta - Value Help para dropdown LineStatus (dominio ZREING_CA_LINE_STATUS)
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingCALineStatusVH', element: 'LineStatus' } }]
  //End Insert V001 (CC) - F6 delta
  LineStatus;

  // Begin Change ID V003 (07.09.2026 | EXT_GONZALCA)
  // StatusCriticality -- technical support field for the LineStatus
  // criticality. Hidden as a column, not added to any fieldGroup. Do NOT
  // use @UI.hiddenFilter: unsupported in this on-premise release (see the
  // ERR-002 note in the DDLX of ZC_ReingCALine).
  @UI.hidden: true
  StatusCriticality;
  // End Change ID V003 (07.09.2026 | EXT_GONZALCA)

  // Begin Insert V007 (16.09.2026 | EXT_GONZALCA)
  // Point 3.1: the two constant criticality fields of ZC_ReingCALineAll
  // V007, referenced by the dataPoints above. Technical support fields --
  // hidden as columns, no fieldGroup, no lineItem, exactly like
  // StatusCriticality. Same treatment as in the DDLX of ZC_ReingCALine.
  @UI.hidden: true
  CritCriticalFix;

  @UI.hidden: true
  CritPositiveFix;
  // End Insert V007 (16.09.2026 | EXT_GONZALCA)

  @UI.fieldGroup: [{ qualifier: 'Estado', position: 20 }]
  SimMessage;

  // Begin Change ID V002 (03.08.2026 | EXT_GONZALCA)
  // Descripcion : Delta v2 CA-04/CA-09 -- HasPcBreakdown retirado (columna
  // fisica ya no existe, step_pc_split siempre genera apertura); se
  // exponen los 3 campos delta nuevos en el mismo fieldGroup Estado.
  @UI.fieldGroup: [{ qualifier: 'Estado', position: 30 }]
  // Begin Change (27.08.2026 | EXT_AGFAGINA) - badge Delta en la tabla principal
  // Mismo patron que LineStatus/StatusCriticality en ZC_ReingCALine.
  // DeltaCriticality: 3 (positive) si IsDelta = 'X', 0 (neutral) si no.
  @UI.lineItem: [{ position: 45, importance: #MEDIUM, label: 'Delta',
                   criticality: 'DeltaCriticality',
                   criticalityRepresentation: #WITH_ICON }]
  // End Change (27.08.2026 | EXT_AGFAGINA)
  IsDelta;

  @UI.fieldGroup: [{ qualifier: 'Estado', position: 31 }]
  DeltaSeq;

  @UI.fieldGroup: [{ qualifier: 'Estado', position: 32 }]
  @Consumption.filter.multipleSelections: true
  DeltaBaseAmt;
  // End Change ID V002 (03.08.2026 | EXT_GONZALCA)

  // Begin Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @EndUserText.label: 'Huerfano'
  // End Change ID V004 (11.09.2026 | EXT_GONZALCA)
  @UI.selectionField: [{ position: 110 }]
  @UI.lineItem:       [{ position: 210, importance: #MEDIUM }]
  @UI.fieldGroup:     [{ qualifier: 'Estado', position: 40 }]
  IsOrphan;

  @UI.fieldGroup: [{ qualifier: 'Estado', position: 50 }]
  InsumoCheckAt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 120 }]
  @Consumption.filter.multipleSelections: true
  ParentNetAmt;

  @UI.fieldGroup: [{ qualifier: 'Montos', position: 130 }]
  ParentCurrency;

  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 10 }]
  DeferPct;

  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 20 }]
  DeferCuotaNum;

  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 30 }]
  DeferCuotaTotal;

  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 40 }]
  DeferFrom;

  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 50 }]
  DeferTo;

  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 60 }]
  OriginRunId;

  // Begin Change ID V005 (15.09.2026 | EXT_GONZALCA)
  // Header facets of the 4 KPIs -- purpose #HEADER, so their positions do
  // not compete with the body facets. Same pattern as ZC_ReingCALine.
  // Body: detail tree of ZC_ReingCALine with every target reached through
  // the _Line hop; ids and labels as requested by Frontend on 15.09.2026.
  @UI.facet: [
    { id: 'KpiBrutoF',     type: #DATAPOINT_REFERENCE, targetQualifier: 'KpiBruto',     purpose: #HEADER, position: 10 },
    { id: 'KpiImpuestoF',  type: #DATAPOINT_REFERENCE, targetQualifier: 'KpiImpuesto',  purpose: #HEADER, position: 20 },
    { id: 'KpiNetoCtoF',   type: #DATAPOINT_REFERENCE, targetQualifier: 'KpiNetoCto',   purpose: #HEADER, position: 30 },
    { id: 'KpiNetoLocalF', type: #DATAPOINT_REFERENCE, targetQualifier: 'KpiNetoLocal', purpose: #HEADER, position: 40 },

    { id: 'Detalles',
      type: #COLLECTION,
      label: 'Detalles',
      position: 10 },
      { id: 'Contrato',      type: #COLLECTION, label: 'Contrato',      parentId: 'Detalles', position: 10 },
        { id: 'ContratoF',     type: #FIELDGROUP_REFERENCE, targetQualifier: 'Contrato',     targetElement: '_Line', parentId: 'Contrato',     position: 10 },
      { id: 'Distribucion',  type: #COLLECTION, label: 'Distribución',  parentId: 'Detalles', position: 20 },
        { id: 'DistribucionF', type: #FIELDGROUP_REFERENCE, targetQualifier: 'Distribucion', targetElement: '_Line', parentId: 'Distribucion', position: 10 },
      { id: 'Conversion',    type: #COLLECTION, label: 'Conversión',    parentId: 'Detalles', position: 30 },
        { id: 'ConversionF',   type: #FIELDGROUP_REFERENCE, targetQualifier: 'Conversion',   targetElement: '_Line', parentId: 'Conversion',   position: 10 },
      { id: 'Referencia',    type: #COLLECTION, label: 'Referencia',    parentId: 'Detalles', position: 40 },
        { id: 'ReferenciaF',   type: #FIELDGROUP_REFERENCE, targetQualifier: 'Referencia',   targetElement: '_Line', parentId: 'Referencia',   position: 10 },
      { id: 'Origen',        type: #COLLECTION, label: 'Origen',        parentId: 'Detalles', position: 50 },
        { id: 'OrigenF',       type: #FIELDGROUP_REFERENCE, targetQualifier: 'Origen',       targetElement: '_Line', parentId: 'Origen',       position: 10 },
      // Begin Insert V010 (18.09.2026 | EXT_GONZALCA)
      // ET v50 SS9.3. Same _Line hop as the 5 sections above -- the field
      // group lives in the DDLX of ZC_ReingCALine (V005), not here.
      // position 60 leaves the 5 existing sub-collections unrenumbered.
      // CAREFUL: 'Origen' (50) and 'OrigenDelta' (60) are TWO DIFFERENT
      // sections. The first one is the deferral parent/instalment origin
      // (ParentOpType, OriginRunId, DeferPct...); this one is the origin of
      // the DELTA (DeltaSeq, DeltaBaseAmt, BrutoAmt, TotalEfectivo).
      // Do not merge them.
      { id: 'OrigenDelta',   type: #COLLECTION, label: 'Origen del Delta', parentId: 'Detalles', position: 60 },
        { id: 'OrigenDeltaF', type: #FIELDGROUP_REFERENCE, targetQualifier: 'OrigenDelta',  targetElement: '_Line', parentId: 'OrigenDelta',  position: 10 },
      // End Insert V010 (18.09.2026 | EXT_GONZALCA)

    { id: 'LinePCTab',
      type: #LINEITEM_REFERENCE,
      label: 'Apertura por Dimensiones',
      position: 20,
      targetElement: '_Line._LinePC' },
    { id: 'LineStepTab',
      type: #LINEITEM_REFERENCE,
      label: 'Secuencia de Calculo',
      position: 30,
      targetElement: '_Line._Step' },
    { id: 'LineLogTab',
      type: #LINEITEM_REFERENCE,
      label: 'Log de Eventos',
      position: 40,
      targetElement: '_Line._Log' },
    { id: 'ContabDocTab',
      type: #LINEITEM_REFERENCE,
      label: 'Documentos Contables',
      position: 50,
      targetElement: '_Line._ContabDocC' }
  ]
  // End Change ID V005 (15.09.2026 | EXT_GONZALCA)
  @UI.fieldGroup: [{ qualifier: 'Diferimiento', position: 70 }]
  OriginLineNum;

  // V001 (CC) - CA-11 (Brazil): transaction-currency fields.
  @EndUserText.label: 'Moneda de transacción'
  @UI.lineItem: [{ position: 300, importance: #LOW }]
  @UI.fieldGroup: [{ qualifier: 'Montos', position: 140 }]
  TransCurrency;

  @EndUserText.label: 'Neto en moneda de transacción'
  @UI.lineItem: [{ position: 310, importance: #LOW }]
  @UI.fieldGroup: [{ qualifier: 'Montos', position: 150 }]
  NetTransAmt;

  @EndUserText.label: 'Tasa contrato a transacción'
  @UI.lineItem: [{ position: 320, importance: #LOW }]
  @UI.fieldGroup: [{ qualifier: 'Montos', position: 160 }]
  ExchRate1;

  @EndUserText.label: 'Tipo tasa contrato a transacción'
  @UI.lineItem: [{ position: 330, importance: #LOW }]
  @UI.fieldGroup: [{ qualifier: 'Montos', position: 170 }]
  ExchRate1Type;
}

