//----------------------------------------------------------------------
// Created by     : Oscar Augusto Leal Dominguez (EXT_OSCUGALD)
// Change ID      : V001
// Date           : 10.07.2026
// Description    : App CA - F6-05 Tab Log de Eventos: columnas de la
//                  tabla anidada Log en el Object Page CalcLine.
//                  Muestra cronologicamente cada evento del ciclo de
//                  vida de la linea (RESET, RELEASE, DELETE, etc).
//                  Patron ET §9.3 "Log de Eventos: tabla LOG_A".
// Transport      : DS4K9B5XZC
// Reference      : 5000049390
//----------------------------------------------------------------------
// Begin Change ID V001 (10.07.2026 | EXT_OSCUGALD)
// Descripcion : Creacion inicial DDLX ZC_ReingCALog para F6-05.
// End Change ID V001 (10.07.2026 | EXT_OSCUGALD)
//----------------------------------------------------------------------
@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName:       'Evento de Log',
  typeNamePlural: 'Log de Eventos',
  title:          { type: #STANDARD, value: 'Action' },
  description:    { type: #STANDARD, value: 'CreatedAt' }
}

annotate view ZC_ReingCALog with
{
  @UI.fieldGroup: [{ qualifier: 'LogKey', position: 10 }]
  CalcRunId;

  @UI.fieldGroup: [{ qualifier: 'LogKey', position: 20 }]
  LineNum;

  // Begin Change ID V001 (14.07.2026 | EXT_GONZALCA)
  // Descripcion : reorden completo de lineItem del tab "Log de Eventos" (pedido de Frontend): LogNum baja a
  // posicion 5/LOW; CreatedAt se agrega como columna nueva en posicion 10/MEDIUM (antes sin lineItem);
  // Action/StatusFrom/StatusTo se mantienen sin cambio de importancia, solo se corre la posicion; CreatedBy
  // sube de posicion 60 a 50 (importancia sin cambio, MEDIUM); Message baja de posicion 50 a 60 (importancia
  // sin cambio, HIGH). fieldGroup LogKey/LogData de cada campo sin cambios - reintegrados en esta iteracion
  // (ver OB-007), no estaban en el archivo de la iteracion #1.
  @UI.lineItem:   [{ position: 5, importance: #LOW }]
  @UI.fieldGroup: [{ qualifier: 'LogKey', position: 30 }]
  LogNum;

  @UI.lineItem:   [{ position: 20, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'LogData', position: 10 }]
  Action;

  @UI.lineItem:   [{ position: 30, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'LogData', position: 20 }]
  StatusFrom;

  @UI.lineItem:   [{ position: 40, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'LogData', position: 30 }]
  StatusTo;

  @UI.lineItem:   [{ position: 60, importance: #HIGH }]
  @UI.fieldGroup: [{ qualifier: 'LogData', position: 40 }]
  Message;

  @UI.lineItem:   [{ position: 50, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'LogData', position: 50 }]
  CreatedBy;

  @UI.lineItem:   [{ position: 10, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'LogData', position: 60 }]
  CreatedAt;
  // End Change ID V001 (14.07.2026 | EXT_GONZALCA)

  @UI.facet: [
    { id: 'LogKey', type: #COLLECTION, label: 'Identificacion', position: 10 },
    { id: 'LogKeyFields', type: #FIELDGROUP_REFERENCE, targetQualifier: 'LogKey', parentId: 'LogKey', position: 10 },
    { id: 'LogData', type: #COLLECTION, label: 'Datos del Evento', position: 20 },
    { id: 'LogDataFields', type: #FIELDGROUP_REFERENCE, targetQualifier: 'LogData', parentId: 'LogData', position: 10 }
  ]
  GroupRunId;
}
