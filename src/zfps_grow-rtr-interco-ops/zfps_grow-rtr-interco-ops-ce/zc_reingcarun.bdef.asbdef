projection;
strict ( 2 );
// Begin Change ID V004 (10.07.2026 | EXT_OSCUGALD)
// Descripcion : F6-06 - Hereda side effects del BDEF base ZI_ReingCARun
//               para que Fiori Elements reciba las anotaciones de refresco
//               en el metadata OData V4 del servicio ZREING_CA_UI_V4.
use side effects;
// End Change ID V004 (10.07.2026 | EXT_OSCUGALD)

define behavior for ZC_ReingCARun alias CalcRun
{
  use action InitializePeriod;
  // Begin Change ID V002 (10.07.2026 | EXT_OSCUGALD)
  use action Calculate;
  // End Change ID V002 (10.07.2026 | EXT_OSCUGALD)
  // Begin Change ID V003 (10.07.2026 | EXT_OSCUGALD)
  // Expone Release y Delete en la capa OData/UI (ZREING_CA_SRV).
  use action Release;
  use action Delete;
  // End Change ID V003 (10.07.2026 | EXT_OSCUGALD)
  // Begin Change ID V005 (10.07.2026 | EXT_OSCUGALD)
  // Descripcion : F6-07 - Expone ExportExcel en la capa OData/UI.
  use action ExportExcel;
  // V001 (CC) - #119 (Delta v2): expose the collection download.
  use action ExportFilteredExcel;
  // End Change ID V005 (10.07.2026 | EXT_OSCUGALD)
  // Begin Change ID V006 (CC) - F4 (05.08.2026 | EXT_GONZALCA)
  // Expone Simulate/Post/Storno en la capa OData/UI (ZREING_CA_SRV /
  // ZREING_CA_UI_V4). "use side effects" ya esta declarado y hereda
  // automaticamente los 3 sub-bloques nuevos de la entidad base.
  use action Simulate;
  use action Post;
  use action Storno;
  // End Change ID V006 (CC) - F4
  use association _Line;
}

// V002 (CC) - se quito "use create;" de los 4 bloques siguientes: la entidad
// base managed (ZI_ReingCA*) no declara "create;" propio en ninguno de estos 4
// (solo se crean via la asociacion { create; } del padre) -- "use create;" en la
// proyeccion exige que la entidad base SI tenga esa operacion declarada.
define behavior for ZC_ReingCALine alias CalcLine
{
  use association _Run;
  use association _LinePC { create; }
  use association _Step   { create; }
  use association _Log    { create; }
}

// V003 (CC) - DD-B6: se agrego "use association _Run;" -- la entidad base ahora
// tiene esa asociacion (necesaria para "lock dependent by _Run"), la proyeccion
// debe exponerla tambien para poder proyectar la relacion de lock master.
define behavior for ZC_ReingCALinePC alias CalcLinePC
{
  use association _Line;
  use association _Run;
}

define behavior for ZC_ReingCAStep alias CalcStep
{
  use association _Line;
  use association _Run;
}

define behavior for ZC_ReingCALog alias CalcLog
{
  use association _Line;
  use association _Run;
}