//----------------------------------------------------------------------
// Modified by    : Carlos Alexander Gonzalez Lopez (EXT_GONZALCA)
// Requirement N° :
// Change ID      : V001
// Date           : 08.07.2026
// Description    : App CA - Motor de Calculo IC - F3.1 Fundamentos RAP
// Transport      : DS4K9B5XZC
// Reference      : 5000049390
//----------------------------------------------------------------------
//--- Mantenimiento ---
// Begin Change ID V002 (10.07.2026 | EXT_OSCUGALD)
// Descripcion : F3.2 Calculate + APJ - action Calculate + with additional save.
// End Change ID V002 (10.07.2026 | EXT_OSCUGALD)
//
// Begin Change ID V003 (10.07.2026 | EXT_OSCUGALD)
// Descripcion : F3.3 Release + Delete - Se agregan:
//               (1) action Release (features:instance): transicion CALC->LIBD
//                   sincrona (F3.3-DD-1). Registra CALCUSAGE via Insumo Mgr.
//                   Solo origen CALC en esta fase (DD-5; se amplia con SIM_OK
//                   cuando F4 agregue Simulate).
//                   ConsistencyCheck se implementa como metodo privado del LHC
//                   invocado al inicio de release() -- la sintaxis BDEF
//                   "validation on save { action X; }" no existe en RAP estandar
//                   (solo CUD + field son triggers validos). El mensaje de
//                   warning se emite con severity=warning (sin %is_transition,
//                   componente inexistente -- ver Fix 7 del addendum iteracion 4).
//                   P3.3-1 (popup nativo 412 de Fiori Elements) SIGUE ABIERTA,
//                   sin verificacion funcional -- no asumir "resuelta".
//               (2) action Delete (features:instance): elimina grupos IS_ORPHAN.
//                   LOG_A y borrado LINE_A/PC/STEP por SQL directo (DD-2/DD-3).
// End Change ID V003 (10.07.2026 | EXT_OSCUGALD)
//
// V012 | 05.08.2026 | EXT_GONZALCA | F4: actions Simulate/Post/Storno en CalcRun,
//        side effects de las 3, y eventos de negocio Posted/Reversed en CalcLine.
//        [ACTIVATOR NOTE: el patch original citaba como ancla "la ultima linea
//        del bloque de mantenimiento, la de V011 (04.08.2026)", pero el bloque
//        --- Mantenimiento --- real solo contiene entradas V002/V003 (V004..V011
//        no registraron linea aqui). Se inserta al final del bloque real
//        existente, que logra la misma intencion documental. Deviacion de
//        aplicacion no bloqueante, reportada en activation-report.md.]
//----------------------------------------------------------------------
managed implementation in class zbp_reingcarun unique;
strict ( 2 );

define behavior for ZI_ReingCARun alias CalcRun
  persistent table zreing_ca_run_a
  lock master
  authorization master ( global, instance )
  etag master LocalLastChangedAt
{
  // V006 (CC) - todos los campos seteados por el CREATE interno de InitializePeriod
  // deben ser "readonly:update" (settable en create, inmutable despues).
  field ( readonly : update ) CalcRunId, FiscalPeriod, FiscalYear, TotalLines, TotalGroups, CreatedBy, CreatedAt;

  // V005 (CC) - factory action necesita "create;" declarado en la propia entidad.
  create;

  static factory action InitializePeriod parameter ZREING_CA_S_INIT_PERIOD [1];

  // Begin Change ID V002 (10.07.2026 | EXT_OSCUGALD)
  // Begin Change ID V008 (15.07.2026 | EXT_GONZALCA)
  // Fix 002: Calculate deja de ser instance-bound. Recibe fiscal_year/
  // fiscal_period/groups y hace find-or-create del Run (logica compartida
  // DRY con InitializePeriod, que se deja dormida). static action (NO factory:
  // opera sobre datos ya existentes y devuelve result [0..*] $self, a
  // diferencia de una factory action cuyo unico canal de respuesta es
  // "mapped" -- ver SAP Help "Action Definition"). result [0..*] (no [1])
  // porque una static action puede invocarse en bulk y, por CU-6, devolver
  // 0 instancias. Linea V002 original conservada como comentario historico:
  // action Calculate parameter ZREING_CA_S_ACTION_SCOPE result [1] $self;
  static action Calculate parameter ZREING_CA_S_CALCULATE_SCOPE;
  // End Change ID V008 (15.07.2026 | EXT_GONZALCA)
  // End Change ID V002 (10.07.2026 | EXT_OSCUGALD)

  // Begin Change ID V003 (10.07.2026 | EXT_OSCUGALD)
  // Release: transicion CALC->LIBD + registro CALCUSAGE. Sincrono (DD-1).
  action ( features : instance ) Release parameter ZREING_CA_S_ACTION_SCOPE result [1] $self;

  // Delete: elimina grupos IS_ORPHAN. SQL directo para LOG/LINE/PC/STEP (DD-2/3).
  action ( features : instance ) Delete parameter ZREING_CA_S_ACTION_SCOPE result [1] $self;
  // End Change ID V003 (10.07.2026 | EXT_OSCUGALD)

  // Begin Change ID V012 (CC) - F4 (05.08.2026 | EXT_GONZALCA)
  // F4-03/04/05: Simulate/Post/Storno. Mismo patron que Release/Delete (V003):
  // instance-bound, scope de grupos, resultado $self. Cada una invoca
  // ZCL_REING_CONTAB_ENGINE=>process_line con su iv_mode (C/P/S) -- llamada
  // directa, sin ZIF_REING_CONTAB_DISPATCHER (diseno obsoleto, WBS L210).
  // Las 3 se declaran juntas: Storno ya no esta gated (CLAR-01 resuelta).

  action ( features : instance ) Simulate parameter ZREING_CA_S_ACTION_SCOPE result [1] $self;
  action ( features : instance ) Post     parameter ZREING_CA_S_ACTION_SCOPE result [1] $self;
  action ( features : instance ) Storno   parameter ZREING_CA_S_ACTION_SCOPE result [1] $self;
  // End Change ID V012 (CC) - F4

  // Begin Change ID V005 (10.07.2026 | EXT_OSCUGALD)
  // Descripcion : F6-07 Export Excel - accion sincrona que genera un .xlsx
  //               con el resumen de todas las LINE_As calculadas del Run
  //               (excluye PEND). Columnas dinamicas por TAX_TYPE non-GU.
  //               Apertura por CeBe cuando HAS_PC_BREAKDOWN = X (ET §12).
  //               Implementada en METHOD exportexcel de lhc_zi_reingcarun.
  // Begin Change ID V009 (15.07.2026 | EXT_GONZALCA)
  // Fix F6-07-B1: se cambia el tipo de resultado de $self a un abstract
  // entity propio (ZI_ReingCAExportResult) para poder transportar el binario
  // .xlsx generado (FileContent base64/FileName/MimeType) -- mismo patron ya
  // usado en produccion por ZI_ReingMEHeader~ExportTemplate (App ME, FX-XLS).
  // $self no tiene ningun campo capaz de portar el archivo.
  action ( features : instance ) ExportExcel result [1] ZI_ReingCAExportResult;
  // V001 (CC) - #119 (Delta v2): download the applied list selection.
  static action ExportFilteredExcel parameter ZREING_CA_S_EXPORT_FILTER result [1] ZI_ReingCAExportResult;
  // End Change ID V009 (15.07.2026 | EXT_GONZALCA)
  // End Change ID V005 (10.07.2026 | EXT_OSCUGALD)

  // Begin Change ID V004 (10.07.2026 | EXT_OSCUGALD)
  // Descripcion : F6-06 Polling UI - Side effects para refresco automatico
  //               de la UI tras ejecutar cada accion. Calculate recarga todos
  //               los campos del Run, permisos de botones, mensajes y CalcLines.
  //               Release/Delete: idem sin reload de _Line (no modifican hijas
  //               en el LUW de la accion, excepto Delete que si las borra).
  //               Disponible desde S/4HANA 2023 (release 7.58), confirmado.
  // Begin Change ID V006 (13.07.2026 | EXT_OSCUGALD)
  // Fix warning V4: "messages" no soportado como target de side effects
  // en este release -- quitado de los 3 actions (Calculate/Release/Delete).
  // Begin Change ID V008 (15.07.2026 | EXT_GONZALCA)
  // Fix 002 - Plan B (fallo de activacion real EU 202 "Static action/function
  // Calculate is not allowed here"): RAP NO permite que una static action
  // aparezca en side effects, ni como FUENTE ("action Calculate affects ...")
  // ni como REFERENCIA en las listas "permissions ( action Calculate, ... )"
  // de otras acciones. Como Calculate paso a static action, se retiran TODAS
  // sus apariciones del bloque side effects:
  //   (1) se elimina el sub-bloque fuente de Calculate, que era:
  //         action Calculate affects field *,
  //                                    permissions ( action Calculate,
  //                                                  action Release,
  //                                                  action Delete ),
  //                                    entity _Line;
  //   (2) se quita "action Calculate" de las listas permissions de Release y
  //       Delete (antes: permissions ( action Calculate, action Release,
  //       action Delete )).
  // EFECTO FUNCIONAL: se pierde el auto-refresh de UI via RAP tras Calcular
  // (anotacion F6-06 de polling para esa accion). NO afecta el calculo; el
  // frontend maneja el refresco tras la accion. Es consecuencia necesaria de
  // Calculate como static action.
  // CORRECCION (26.08.2026): el texto anterior decia que "el result [0..*] $self
  // que devuelve Calculate alimenta el refresco estandar de Fiori Elements".
  // ESO NO ES ASI y quedo como texto residual: al intentarlo fallo la activacion
  // con "No component %TKY" -- una static action NO expone %tky y por lo tanto
  // NO puede devolver $self (ver comentario "Fix 002 (it7)" en METHOD calculate).
  // Calculate hoy NO tiene result: el refresco tras Calcular es 100% del frontend.
  // Si en el futuro se quiere una via de refresco por RAP, la unica opcion viable
  // seria un result con abstract entity propia (patron de ExportExcel), no $self.
  side effects {
    // Mod (26.08.2026): Release cambia LineStatus CALC/SIM_OK -> LIBD, por lo que
    // necesita "entity _Line" para refrescar la tabla (era la unica accion sin el).
    // Se amplian tambien los permissions a Simulate/Post/Storno: tras un Release
    // cambia el enabled de Contabilizar y quedaba desactualizado.
    action Release  affects field *,
                               permissions ( action Simulate, action Post,
                                             action Storno,   action Release,
                                             action Delete ),
                               entity _Line;
    action Delete   affects field *,
                               permissions ( action Release,
                                             action Delete ),
                               entity _Line;
    // Begin Change ID V012 (CC) - F4
    action Simulate affects field *,
                               permissions ( action Simulate, action Post,
                                             action Storno,   action Release ),
                               entity _Line;
    action Post     affects field *,
                               permissions ( action Simulate, action Post,
                                             action Storno,   action Release ),
                               entity _Line;
    action Storno   affects field *,
                               permissions ( action Simulate, action Post,
                                             action Storno,   action Release ),
                               entity _Line;
    // End Change ID V012 (CC) - F4
  }
  // End Change ID V008 (15.07.2026 | EXT_GONZALCA)
  // End Change ID V006 (13.07.2026 | EXT_OSCUGALD)
  // End Change ID V004 (10.07.2026 | EXT_OSCUGALD)

  event Posted   parameter ZI_ReingCAPostedEvent;
  event Reversed parameter ZI_ReingCAReversedEvent;

  association _Line { create; }

  mapping for zreing_ca_run_a
    {
      CalcRunId          = calc_run_id;
      FiscalPeriod       = fiscal_period;
      FiscalYear         = fiscal_year;
      TotalLines         = total_lines;
      TotalGroups        = total_groups;
      CreatedBy          = created_by;
      CreatedAt          = created_at;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZI_ReingCALine alias CalcLine
  persistent table zreing_ca_line_a
  lock dependent by _Run
  authorization dependent by _Run
  etag master LocalLastChangedAt
  // Begin Change ID V002 (10.07.2026 | EXT_OSCUGALD)
  with additional save
  // End Change ID V002 (10.07.2026 | EXT_OSCUGALD)
{
  // Begin Change ID V007 (11.07.2026 | EXT_GONZALCA) - fix ERR-003 Fix 1
  // Descripcion : "readonly" a secas bloqueaba el CREATE interno de LineNum
  //               (mismo bug ya documentado en feedback-rap-factory-action-mechanics,
  //               F3.1). Calculate necesita fijar LineNum al crear cada linea nueva.
  field ( readonly : update ) CalcRunId, LineNum;
  // End Change ID V007 (11.07.2026 | EXT_GONZALCA)

  association _Run;
  association _LinePC { create; }
  association _Step   { create; }
  association _Log    { create; }

  // Begin Change ID V012 (CC) - F4
  // Eventos de negocio RAP (ET §8b). Se declaran sobre CalcLine (no sobre una
  // entidad "zreing_contab": ese nombre es del pseudocodigo ilustrativo de la
  // ET y no existe en ningun objeto real). Sintaxis confirmada contra SAP Help
  // ("Business Events" / "Develop Business Events"): un statement "event" por
  // evento, parametro = CDS abstract entity. NO existe un bloque "events { }".
  // El disparo va en la fase SAVE tardia (lsc_zi_reingcarun~save_modified),
  // habilitado por el "with additional save" que esta entidad ya declara (V002).
//  event Posted   parameter ZI_ReingCAPostedEvent;
//  event Reversed parameter ZI_ReingCAReversedEvent;
  // End Change ID V012 (CC) - F4

  mapping for zreing_ca_line_a
    {
      CalcRunId          = calc_run_id;
      LineNum            = line_num;
      CtUuid             = ct_uuid;
      CtId               = ct_id;
      Lifnr              = lifnr;
      BpName             = bp_name;
      BukrsPrest         = bukrs_prest;
      MatUuid            = mat_uuid;
      Matnr              = matnr;
      OpType             = op_type;
      OpUuid             = op_uuid;
      CmHId              = cm_h_id;
      CmLoadSeq          = cm_load_seq;
      OpInstanceNum      = op_instance_num;
      ParentOpType       = parent_op_type;
      OriginRunId        = origin_run_id;
      OriginLineNum      = origin_line_num;
      ParentNetAmt       = parent_net_amt;
      ParentCurrency     = parent_currency;
      DeferPct           = defer_pct;
      DeferCuotaNum      = defer_cuota_num;
      DeferCuotaTotal    = defer_cuota_total;
      DeferFrom          = defer_from;
      DeferTo            = defer_to;
      BukrsRecv          = bukrs_recv;
      Country            = country;
      BaseAmt            = base_amt;
      SharePct           = share_pct;
      SharePaisPct       = share_pais_pct;
      ShareCombPct       = share_comb_pct;
      CalcAmt            = calc_amt;
      BrutoAmt           = bruto_amt;
      GrossUpAmt         = gross_up_amt;
      TaxAmt             = tax_amt;
      NetAmt             = net_amt;
      CtCurrency         = ct_currency;
      NetLocalAmt        = net_local_amt;
      LocalCurrency      = local_currency;
      ExchRate           = exch_rate;
      ExchRateType       = exch_rate_type;
      // V001 (CC) - CA-11 (Brazil): persistent TRANS fields.
      TransCurrency      = trans_currency;
      NetTransAmt        = net_trans_amt;
      ExchRate1          = exch_rate_1;
      ExchRate1Type      = exch_rate_1_type;
      // Begin Change ID V011 (04.08.2026 | EXT_GONZALCA)
      // Descripcion : HasPcBreakdown retirado (CA-05/CA-09 lo quitaron de la
      // CDS y la tabla); se agregan IsDelta/DeltaSeq/DeltaBaseAmt (CA-02),
      // expuestos en la CDS desde CA-05 pero nunca conectados aqui.
      IsDelta            = is_delta;
      DeltaSeq           = delta_seq;
      DeltaBaseAmt       = delta_base_amt;
      // End Change ID V011 (04.08.2026 | EXT_GONZALCA)
      LineStatus         = line_status;
      SimMessage         = sim_message;
      ProcStartedAt      = proc_started_at;
      ProcHeartbeatAt    = proc_heartbeat_at;
      ProcJobId          = proc_job_id;
      InsumoCheckAt      = insumo_check_at;
      FiAwkey            = fi_awkey;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZI_ReingCALinePC alias CalcLinePC
  persistent table zreing_ca_lpc_a
  lock dependent by _Run
  authorization dependent by _Run
{
  field ( readonly ) CalcRunId, LineNum, PcSeq;
  // V001 (CC) - CA-11 (Brazil): currency is derived from the parent line.
  field ( readonly ) TransCurrency;

  association _Line;
  association _Run;

  mapping for zreing_ca_lpc_a
    {
      CalcRunId     = calc_run_id;
      LineNum       = line_num;
      PcSeq         = pc_seq;
      Prctr         = prctr;
      // Begin Change ID V011 (04.08.2026 | EXT_GONZALCA)
      // Descripcion : Campana/RoleCategory/Allocation (CA-01) nunca se
      // conectaron aqui aunque ya estan expuestos en la CDS desde CA-05.
      Campana       = campana;
      RoleCategory  = role_category;
      Allocation    = allocation;
      // End Change ID V011 (04.08.2026 | EXT_GONZALCA)
      ShareAbs      = share_abs;
      CalcAmt       = calc_amt;
      BrutoAmt      = bruto_amt;
      TaxAmt        = tax_amt;
      NetAmt        = net_amt;
      CtCurrency    = ct_currency;
      NetLocalAmt   = net_local_amt;
      LocalCurrency = local_currency;
      // V001 (CC) - CA-11 (Brazil): LPC amounts in TRANS currency.
      BrutoTransAmt = bruto_trans_amt;
      NetTransAmt   = net_trans_amt;
    }
}

define behavior for ZI_ReingCAStep alias CalcStep
  persistent table zreing_ca_step_a
  lock dependent by _Run
  authorization dependent by _Run
{
  field ( readonly ) CalcRunId, LineNum, StepNum, Seq;
  // V001 (CC) - CA-11 (Brazil): currency is derived from the parent line.
  field ( readonly ) TransCurrency;
  // V001 (CC) - #118: calculated UI criticality has no persistence mapping.
  field ( readonly ) RowCriticality;

  association _Line;
  association _Run;

  mapping for zreing_ca_step_a
    {
      CalcRunId      = calc_run_id;
      LineNum        = line_num;
      StepNum        = step_num;
      Seq            = seq;
      StepCategory   = step_category;
      TaxType        = tax_type;
      TxRuleId       = tx_rule_id;
      StepDesc       = step_desc;
      InputAmt       = input_amt;
      InputCurrency  = input_currency;
      RatePct        = rate_pct;
      RateDesc       = rate_desc;
      OutputAmt      = output_amt;
      OutputCurrency = output_currency;
      // V001 (CC) - CA-11 (Brazil): step output in TRANS currency.
      OutputTransAmt = output_trans_amt;
      Sign           = sign;
      SourceTable    = source_table;
      SourceKey      = source_key;
    }
}

define behavior for ZI_ReingCALog alias CalcLog
  persistent table zreing_ca_log_a
  lock dependent by _Run
  authorization dependent by _Run
{
  field ( readonly ) CalcRunId, LineNum, LogNum;

  association _Line;
  association _Run;

  mapping for zreing_ca_log_a
    {
      CalcRunId   = calc_run_id;
      LineNum     = line_num;
      LogNum      = log_num;
      Action      = action;
      StatusFrom  = status_from;
      StatusTo    = status_to;
      CreatedBy   = created_by;
      CreatedAt   = created_at;
      Message     = message;
      GroupRunId  = group_run_id;
    }
}