@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Historial',
  typeNamePlural: 'Historial de Cambios'
}

@UI.presentationVariant: [{
  sortOrder: [{ by: 'ChangedAt', direction: #DESC }]
}]

annotate view ZC_ReingC2Hist with
{
  @UI.hidden: true
  HistUuid;

  @UI.hidden: true
  CtUuid;

  @EndUserText.label: 'Fecha/Hora'
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  ChangedAt;

  @EndUserText.label: 'Usuario'
  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  ChangedBy;

  @EndUserText.label: 'Nivel'
  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  EntityLevel;

  @EndUserText.label: 'Clave'
  @UI.lineItem: [{ position: 40, importance: #MEDIUM }]
  EntityKey;

  @EndUserText.label: 'Accion'
  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  Action;

  @EndUserText.label: 'Campo'
  @UI.lineItem: [{ position: 60, importance: #HIGH }]
  FieldName;

  @EndUserText.label: 'Valor Anterior'
  @UI.lineItem: [{ position: 70, importance: #HIGH }]
  ValueOld;

  @EndUserText.label: 'Valor Nuevo'
  @UI.lineItem: [{ position: 80, importance: #HIGH }]
  ValueNew;
}