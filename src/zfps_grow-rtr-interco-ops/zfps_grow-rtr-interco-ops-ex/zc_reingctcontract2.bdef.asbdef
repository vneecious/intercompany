projection;
strict ( 2 );
use draft;

define behavior for ZC_ReingCTContract2 alias Contract
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action ActivateContract;
  use action InactivateContract;
  use action ReactivateContract;
  use action ArchiveContract;
  use action UploadReceivers;
  use action UploadGLLines;

  use association _Materials { create; with draft; }
  use association _History { with draft; }
}

define behavior for ZC_ReingCTMaterial2 alias Material
{
  use update;
  use delete;

  use association _Contract { with draft; }
  use association _OpTypes { create; with draft; }
  use association _Receivers { create; with draft; }
  use association _Metrics { create; with draft; }
  use association _GLLines { create; with draft; }
}

define behavior for ZC_ReingCTOpType2 alias OpType
{
  use update;
  use delete;

  use association _Material { with draft; }
  use association _Contract { with draft; }
  use association _Cron { create; with draft; }
  use association _OpRates { create; with draft; }
}

define behavior for ZC_ReingCTOpRate2 alias OpRate
{
  use update;
  use delete;

  use association _OpType { with draft; }
  use association _Contract { with draft; }
}

define behavior for ZC_ReingCTCron2 alias Cron
{
  use update;
  use delete;

  use association _OpType { with draft; }
  use association _Contract { with draft; }
}

define behavior for ZC_ReingCTReceiver2 alias Receiver
{
  use update;
  use delete;

  use association _Material { with draft; }
  use association _Contract { with draft; }
}

define behavior for ZC_ReingCTMetric2 alias Metric
{
  use update;
  use delete;

  use association _Material { with draft; }
  use association _Contract { with draft; }
}

define behavior for ZC_ReingCTGL2 alias GL
{
  use update;
  use delete;

  use association _Material { with draft; }
  use association _Contract { with draft; }
  use association _OpTypes  { create; with draft; }
}

define behavior for ZC_ReingCTGLOpType2 alias GLOpType
{
  use update;
  use delete;

  use association _GL       { with draft; }
  use association _Contract { with draft; }
}

define behavior for ZC_ReingC2Hist alias History
{
  use association _Contract { with draft; }
}