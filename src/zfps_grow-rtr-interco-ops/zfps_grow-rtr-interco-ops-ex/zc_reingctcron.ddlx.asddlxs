@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Cronograma',
  typeNamePlural: 'Cronograma',
  title: { type: #STANDARD, value: 'CronYear' },
  description: { type: #STANDARD, value: 'CronMonth' }
}

annotate view ZC_ReingCTCron with
{
  @EndUserText.label: 'Año'
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'CronInfo' }]
  CronYear;

  @EndUserText.label: 'Mes'
  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'CronInfo' }]
  CronMonth;

  @EndUserText.label: 'Porcentaje (%)'
  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'CronInfo' }]
  Percentage;

  @EndUserText.label: 'Estado'
  @UI.lineItem: [{ position: 40, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'CronInfo' }]
  CronStatus;

  @EndUserText.label: 'Contrato'
  @UI.fieldGroup: [{ position: 50, qualifier: 'CronInfo' }]
  @UI.facet: [
    { id: 'CronInfo',
      type: #COLLECTION,
      label: 'Cronograma de Devengamiento',
      position: 10 },
    { id: 'CronInfoFields',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'CronInfo',
      parentId: 'CronInfo',
      position: 10 }
  ]
  CtId;
}