@Metadata.layer: #CUSTOMER

annotate view ZC_ReingCTOpType with
{
  @EndUserText.label: 'Tipo Operación'
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.fieldGroup: [{ position: 10, qualifier: 'OpTypeInfo' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingOpTypes', element: 'OpType' } }]
  OpType;

  @EndUserText.label: 'Subtipo'
  @UI.lineItem: [{ position: 20, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'OpTypeInfo' }]
  OpSubtype;

  @EndUserText.label: 'Distribución'
  @UI.lineItem: [{ position: 30, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'OpTypeInfo' }]
  DistType;

  @EndUserText.label: 'Cuotas'
  @UI.fieldGroup: [{ position: 40, qualifier: 'OpTypeInfo' }]
  Installments;

  @EndUserText.label: 'Fecha Inicio Dev.'
  @UI.lineItem: [{ position: 40, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 50, qualifier: 'OpTypeInfo' }]
  DeferFrom;

  @EndUserText.label: 'Fecha Fin Dev.'
  @UI.lineItem: [{ position: 50, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 60, qualifier: 'OpTypeInfo' }]
  DeferTo;

  @EndUserText.label: 'Tipo Cambio'
  @UI.fieldGroup: [{ position: 70, qualifier: 'OpTypeInfo' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_ExchangeRateType', element: 'ExchangeRateType' } }]
  ExchType;

  @EndUserText.label: 'Tasa de Cambio'
  @UI.fieldGroup: [{ position: 80, qualifier: 'OpTypeInfo' }]
  ExchRate;

  @EndUserText.label: 'Moneda'
  @UI.fieldGroup: [{ position: 90, qualifier: 'OpTypeInfo' }]
  Waers;

  @EndUserText.label: '% Total Devengado'
  @UI.lineItem: [{ position: 60, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 100, qualifier: 'OpTypeInfo' }]
  TotalPct;

  @EndUserText.label: 'Estado'
  @UI.lineItem: [{ position: 70, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 110, qualifier: 'OpTypeInfo' }]
  OpStatus;

  @EndUserText.label: 'Modificado El'
  @UI.fieldGroup: [{ position: 40, qualifier: 'OpTypeInfo' }]
  @UI.facet: [
    { id: 'OpTypeInfo',
      type: #COLLECTION,
      label: 'Datos del Tipo de Operación',
      position: 10 },
    { id: 'OpTypeInfoFields',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'OpTypeInfo',
      parentId: 'OpTypeInfo',
      position: 10 },
    { id: 'Cron',
      type: #LINEITEM_REFERENCE,
      label: 'Cronograma Devengamiento',
      position: 20,
      targetElement: '_Cron' }
  ]
  ChangedAt;
}