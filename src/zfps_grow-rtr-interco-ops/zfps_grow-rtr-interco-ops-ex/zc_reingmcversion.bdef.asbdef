projection;
strict ( 2 );
use draft;

define behavior for ZC_ReingMCVersion
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use action ActivateVersion;
  use action InactivateVersion;
  use action NewVersion;

  field ( readonly ) VersionStatus;
}