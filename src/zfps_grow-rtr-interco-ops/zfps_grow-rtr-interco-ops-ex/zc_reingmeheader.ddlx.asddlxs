@Metadata.layer: #CUSTOMER

@UI.headerInfo: {
  typeName: 'Carga de Métricas',
  typeNamePlural: 'Cargas de Métricas',
  title: { type: #STANDARD, value: 'MeHId' },
  description: { type: #STANDARD, value: 'MeStatus' }
}

annotate view ZC_ReingMEHeader with
{
  @EndUserText.label: 'ID Carga'
  @UI.hidden: true
  @UI.identification: [
    { position: 10 },
    { type: #FOR_ACTION, dataAction: 'CalcularShare',   label: 'Calcular Share%'     },
    { type: #FOR_ACTION, dataAction: 'Enviar',          label: 'Enviar'              },
    { type: #FOR_ACTION, dataAction: 'Devolver',        label: 'Devolver'            },
    { type: #FOR_ACTION, dataAction: 'Liberar',         label: 'Liberar'             },
    { type: #FOR_ACTION, dataAction: 'Reabrir',         label: 'Reabrir'             },
    { type: #FOR_ACTION, dataAction: 'NovaVersaoCarga', label: 'Nueva Versión Carga' }
  ]
  //Begin Mod V001 (CC) - FX-XLS - static action must be collection-bound: moved from identification to lineItem
  @UI.lineItem: [{ type: #FOR_ACTION, dataAction: 'ExportTemplate', label: 'Plantilla', position: 10 }]
  //End Mod V001 (CC) - FX-XLS
  MeHId;

  @EndUserText.label: 'Contrato'
  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.selectionField: [{ position: 20 }]
  @UI.fieldGroup: [{ position: 20, qualifier: 'HeaderInfo' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingCMContractVH', element: 'CtId' } }]
  CtId;

  //Begin Insert V001 (CC) - FX01 - expose Proveedor as list column + filter (pos 25, right after Contrato)
  @EndUserText.label: 'Proveedor'
  @UI.lineItem: [{ position: 25, importance: #HIGH }]
  @UI.selectionField: [{ position: 25 }]
  @UI.fieldGroup: [{ position: 25, qualifier: 'HeaderInfo' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'I_Supplier', element: 'Supplier' } }]
  Proveedor;
  //End Insert V001 (CC) - FX01

  @EndUserText.label: 'N. Contrato Externo'
  @UI.fieldGroup: [{ position: 30, qualifier: 'HeaderInfo' }]
  CtExtNum;

  @EndUserText.label: 'Material'
  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.selectionField: [{ position: 30 }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'HeaderInfo' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingCTMatVH', element: 'Product' } }]
  Matnr;

  @EndUserText.label: 'Año'
  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  //Begin Insert V001 (CC) — FX17 — remove PeriodYear from SelectionFields (frontend uses custom DatePicker)
  //End Insert V001 (CC) — FX17
  @UI.fieldGroup: [{ position: 10, qualifier: 'PeriodInfo' }]
  PeriodYear;

  @EndUserText.label: 'Mes'
  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  //Begin Insert V001 (CC) — FX17 — remove PeriodMonth from SelectionFields (frontend uses custom DatePicker)
  //End Insert V001 (CC) — FX17
  @UI.fieldGroup: [{ position: 20, qualifier: 'PeriodInfo' }]
  PeriodMonth;

  @EndUserText.label: 'Versión Carga'
  @UI.lineItem: [{ position: 60, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 30, qualifier: 'PeriodInfo' }]
  LoadVersion;

  @EndUserText.label: 'Estado'
  @UI.lineItem: [{ position: 70, importance: #HIGH }]
  @UI.selectionField: [{ position: 60 }]
  @UI.fieldGroup: [{ position: 40, qualifier: 'PeriodInfo' }]
  @Consumption.valueHelpDefinition: [{ entity: { name: 'ZI_ReingMEStatusVH', element: 'MeStatus' } }]
  MeStatus;

  @EndUserText.label: 'Código Métrica'
  @UI.lineItem: [{ position: 80, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 50, qualifier: 'PeriodInfo' }]
  MetricCode;

  // Mod 25.09.2026 EXT_AGFAGINA - DF-554: nombre de la metrica junto al codigo.
  @EndUserText.label: 'Nombre Métrica'
  @UI.lineItem: [{ position: 81, importance: #HIGH }]
  @UI.fieldGroup: [{ position: 51, qualifier: 'PeriodInfo' }]
  MetricDesc;

  @EndUserText.label: 'Versión Métrica'
  @UI.fieldGroup: [{ position: 60, qualifier: 'PeriodInfo' }]
  MetVersion;

  @EndUserText.label: 'Total Share %'
  @UI.lineItem: [{ position: 90, importance: #MEDIUM }]
  @UI.fieldGroup: [{ position: 70, qualifier: 'PeriodInfo' }]
  TotalSharePct;

  @EndUserText.label: 'Liberado Por'
  @UI.fieldGroup: [{ position: 10, qualifier: 'ReleaseInfo' }]
  ReleasedBy;

  @EndUserText.label: 'Liberado El'
  @UI.fieldGroup: [{ position: 20, qualifier: 'ReleaseInfo' }]
  ReleasedAt;

  @EndUserText.label: 'Creado Por'
  @UI.fieldGroup: [{ position: 10, qualifier: 'AdminData' }]
  CreatedBy;

  @EndUserText.label: 'Creado El'
  @UI.fieldGroup: [{ position: 20, qualifier: 'AdminData' }]
  CreatedAt;

  @EndUserText.label: 'Modificado Por'
  @UI.fieldGroup: [{ position: 30, qualifier: 'AdminData' }]
  LastChangedBy;

  @UI.facet: [
    { id: 'HeaderInfo',
      type: #COLLECTION,
      label: 'Datos del Contrato',
      position: 10 },
    { id: 'HeaderInfoFields',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'HeaderInfo',
      parentId: 'HeaderInfo',
      position: 10 },
    { id: 'PeriodInfo',
      type: #COLLECTION,
      label: 'Datos del Período',
      position: 20 },
    { id: 'PeriodInfoFields',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'PeriodInfo',
      parentId: 'PeriodInfo',
      position: 10 },
    { id: 'Items',
      type: #LINEITEM_REFERENCE,
      label: 'Valores de Métricas',
      position: 30,
      targetElement: '_Item' },
    { id: 'ReleaseInfo',
      type: #COLLECTION,
      label: 'Datos de Liberación',
      position: 40 },
    { id: 'ReleaseInfoFields',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'ReleaseInfo',
      parentId: 'ReleaseInfo',
      position: 10 },
    { id: 'AdminData',
      type: #COLLECTION,
      label: 'Datos Administrativos',
      position: 50 },
    { id: 'AdminDataFields',
      type: #FIELDGROUP_REFERENCE,
      targetQualifier: 'AdminData',
      parentId: 'AdminData',
      position: 10 }
  ]
  @EndUserText.label: 'Modificado El'
  LastChangedAt;
}