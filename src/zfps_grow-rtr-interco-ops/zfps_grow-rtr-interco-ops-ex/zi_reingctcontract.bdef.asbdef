managed implementation in class ZBP_ReingCTContract unique;
strict ( 2 );
with draft;

define behavior for ZI_ReingCTContract alias Contract
persistent table zreing_ct_a
draft table zreing_ct_d
lock master total etag ChangedAt
authorization master ( instance, global )
etag master ChangedAt
{
  create;
  update;
  delete;

  field ( readonly : update ) CtId;
  field ( readonly ) CtUuid;
  field ( readonly ) TotalAmount;
  field ( readonly ) CtStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation ValidateContractHeader;
    validation ValidateActivation;
    validation Material~ValidateMatnr;
  }

  action ( features : instance ) ActivateContract   result [1] $self;
  action ( features : instance ) InactivateContract result [1] $self;
  action ( features : instance ) ReactivateContract result [1] $self;
  action ( features : instance ) ArchiveContract    result [1] $self;

  determination SetCtStatus     on modify { create; }
  determination CalcTotalAmount on modify { field TotalAmount; }

  validation ValidateContractHeader on save { create; update; }
  validation ValidateActivation     on save { create; update; }

  association _Materials { create; with draft; }

  mapping for zreing_ct_a corresponding
  {
    CtId         = ct_id;
    CtUuid       = ct_uuid;
    Lifnr        = lifnr;
    Bukrs        = bukrs;
    ExtContract  = ext_contract;
    ValidFrom    = valid_from;
    ValidTo      = valid_to;
    Waers        = waers;
    Responsible  = responsible;
    EmailContact = email_contact;
    RenewalDays  = renewal_days;
    TotalAmount  = total_amount;
    CtStatus     = ct_status;
    Comments     = comments;
    CreatedBy    = created_by;
    CreatedAt    = created_at;
    ChangedBy    = changed_by;
    ChangedAt    = changed_at;
  }
}

define behavior for ZI_ReingCTMaterial alias Material
persistent table zreing_ct_mat_a
draft table zreing_ct_mat_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( readonly ) CtId;
  field ( readonly : update ) Matnr;
  field ( readonly ) MatStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;

  determination CalcTotalAmount on modify { field Amount; }

  validation ValidateMatnr on save { create; update; }

  association _Contract  { with draft; }
  association _OpTypes   { create; with draft; }
  association _Receivers { create; with draft; }
  association _Metrics   { create; with draft; }
  association _GLLines   { create; with draft; }

  mapping for zreing_ct_mat_a corresponding
  {
    CtId      = ct_id;
    Matnr     = matnr;
    MatDesc   = mat_desc;
    Amount    = amount;
    Waers     = waers;
    Kostl     = kostl;
    Prctr     = prctr;
    Saknr     = saknr;
    MatStatus = mat_status;
    CreatedBy = created_by;
    CreatedAt = created_at;
    ChangedBy = changed_by;
    ChangedAt = changed_at;
  }
}

define behavior for ZI_ReingCTOpType alias OpType
persistent table zreing_ct_opt_a
draft table zreing_ct_opt_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( readonly ) CtId;
  field ( readonly ) Matnr;
  field ( readonly : update ) OpType;
  field ( readonly ) TotalPct;
  field ( readonly ) OpStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;

  determination AutoCreateLinkedOpType on modify { create; field OpType; }

  validation ValidateOpTypeFields on save { create; update; }

  association _Material { with draft; }
  association _Contract { with draft; }
  association _Cron     { create; with draft; }

  mapping for zreing_ct_opt_a corresponding
  {
    CtId         = ct_id;
    Matnr        = matnr;
    OpType       = op_type;
    OpSubtype    = op_subtype;
    DeferFrom    = defer_from;
    DeferTo      = defer_to;
    DistType     = dist_type;
    Installments = installments;
    ExchType     = exch_type;
    ExchRate     = exch_rate;
    Waers        = waers;
    TotalPct     = total_pct;
    OpStatus     = op_status;
    CreatedBy    = created_by;
    CreatedAt    = created_at;
    ChangedBy    = changed_by;
    ChangedAt    = changed_at;
  }
}

define behavior for ZI_ReingCTCron alias Cron
persistent table zreing_ct_cron_a
draft table zreing_ct_cron_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( readonly ) CtId;
  field ( readonly ) Matnr;
  field ( readonly ) OpType;
  field ( readonly : update ) CronYear;
  field ( readonly : update ) CronMonth;
  field ( readonly ) CronStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;

  validation ValidateCronSum on save { create; update; }

  association _OpType   { with draft; }
  association _Contract { with draft; }

  mapping for zreing_ct_cron_a corresponding
  {
    CtId       = ct_id;
    Matnr      = matnr;
    OpType     = op_type;
    CronYear   = cron_year;
    CronMonth  = cron_month;
    Percentage = percentage;
    CronStatus = cron_status;
    CreatedBy  = created_by;
    CreatedAt  = created_at;
    ChangedBy  = changed_by;
    ChangedAt  = changed_at;
  }
}

