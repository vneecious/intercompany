define behavior for ZI_ReingCTGL2 alias GL
persistent table zreing_ct2_gl_a
draft table zreing_ct2_gl_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( numbering : managed, readonly ) GlUuid;
  field ( readonly ) CtUuid;
  field ( readonly ) MatUuid;
  field ( readonly ) GlSeq;
  field ( readonly ) GlStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;
  field ( features : instance ) Reclassify;
  field ( features : instance ) AutoDeterm;
  // Mod 03.09.2026 EXT_AGFAGINA: Saknr pasa a control de instancia para poder
  // bloquearlo cuando el rol tiene determinacion automatica de cuenta
  // (AUTO_DETERM = 'X'). El flag ya viene heredado del catalogo ZREING_GL_ROLES
  // por SetGlRoleDefaults, asi que la regla se resuelve con el campo de la propia
  // linea y no hace falta releer el catalogo.
  field ( features : instance ) Saknr;


  determination SetGlSeq on modify { create; }
  determination SetGlRoleDefaults on modify { create; field GlRole; }

  validation ValidateNoDuplicateGlRole on save { create; update; }



  association _Material { with draft; }
  association _Contract { with draft; }
  association _OpTypes { create; with draft; }

  mapping for zreing_ct2_gl_a corresponding
    {
      CtUuid     = ct_uuid;
      MatUuid    = mat_uuid;
      GlUuid     = gl_uuid;
      GlSeq      = gl_seq;
      GlRole     = gl_role;
      Saknr      = saknr;
      OpType     = op_type;
      Reclassify = reclassify;
      AutoDeterm = auto_determ;
      GlStatus   = gl_status;
      CreatedBy  = created_by;
      CreatedAt  = created_at;
      ChangedBy  = changed_by;
      ChangedAt  = changed_at;
    }
}


