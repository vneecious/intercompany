// ---------------------------------------------------------------------
// Modification log
// Modified by    : Carlos Alexander Gonzalez Lopez (EXT_GONZALCA)
// Requirement N° :
// Change ID      : V001 (CC)
// Date           : 17.06.2026
// Description    : Fix determinacion SetCtId - numeracion CtId contrato
//                  Fix B1: determination SetCtId on modify -> on save (late numbering)
// Transport      : DS4K9B5VNA
// Reference      : 5000047741
// ---------------------------------------------------------------------
managed with additional save with full data implementation in class ZBP_ReingCTContract2 unique;
strict ( 2 );
with draft;

define behavior for ZI_ReingCTContract2 alias Contract
persistent table zreing_ct2_a
draft table zreing_ct2_d
lock master total etag ChangedAt
authorization master ( instance, global )
etag master ChangedAt
with additional save
{
  create;
  update;
  delete;

  field ( numbering : managed, readonly ) CtUuid;
  field ( readonly ) CtId;
  field ( readonly ) TotalAmount;
  field ( readonly ) CtStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;


  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare
  {
    validation ValidateContractHeader;
    validation ValidateActivation;
    validation ValidateGLRoleConsistency;
    // V001 (CC) - CT-01 (Brazil): validate manual rates after child changes.
    validation ( always ) OpType~ValidateManualRates;
    // V001 (CC) - #111: validate the schedule identity before draft activation.
    validation Cron~ValidateCronInstance;
  }

  action ( features : instance ) ActivateContract result [1] $self;
  action ( features : instance ) InactivateContract result [1] $self;
  action ( features : instance ) ReactivateContract result [1] $self;
  action ( features : instance ) ArchiveContract result [1] $self;

  // P9 - Carga masiva de Sociedades Receptoras via Excel
  action UploadReceivers parameter ZI_ReingCTRecvUploadParam
    result [1] $self;

  // DF-515 - Carga masiva de Lineas GL (Modelo GL) via Excel
  action UploadGLLines parameter ZI_ReingCTGLUploadParam
    result [1] $self;

  determination SetCtStatus on modify { create; }
  // Begin of mod V001 (CC) - DS4K9B5VNA - 5000047741 - EXT_GONZALCA
  //   Original line (commented, never deleted):
  //   determination SetCtId on modify { create; }
  determination SetCtId on save { create; }
  // End of mod V001 (CC) - DS4K9B5VNA - 5000047741 - EXT_GONZALCA

  validation ValidateContractHeader on save { create; update; }
  validation ValidateActivation on save { create; update; }
  validation ValidateGLRoleConsistency on save { create; update; }

  association _Materials { create; with draft; }
  association _History { create; with draft; }

  mapping for zreing_ct2_a corresponding
    {
      CtUuid       = ct_uuid;
      CtId         = ct_id;
      Lifnr        = lifnr;
      Bukrs        = bukrs;
      ExtContract  = ext_contract;
      ValidFrom    = valid_from;
      ValidTo      = valid_to;
      Waers        = waers;
      Responsible  = responsible;
      EmailContact = email_contact;
      RenewalDays  = renewal_days;
      TotalAmount  = total_amount;
      CtStatus     = ct_status;
      Comments     = comments;
      CreatedBy    = created_by;
      CreatedAt    = created_at;
      ChangedBy    = changed_by;
      ChangedAt    = changed_at;
    }
}

define behavior for ZI_ReingCTMaterial2 alias Material
persistent table zreing_ct2_mat_a
draft table zreing_ct2_mat_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( numbering : managed, readonly ) MatUuid;
  field ( readonly ) CtUuid;
  field ( readonly ) Waers;
  field ( readonly ) MatStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;

  determination CalcTotalAmount on modify { field Amount; }
  determination SetMatDesc on modify { field Matnr; }
  determination SetMatWaers on modify { create; }

  validation ValidateMatnr on save { create; update; }

  association _Contract { with draft; }
  association _OpTypes { create ( features : instance ); with draft; }
  association _Receivers { create; with draft; }
  association _Metrics { create; with draft; }
  association _GLLines { create; with draft; }

  mapping for zreing_ct2_mat_a corresponding
    {
      CtUuid    = ct_uuid;
      MatUuid   = mat_uuid;
      Matnr     = matnr;
      MatDesc   = mat_desc;
      Amount    = amount;
      Waers     = waers;
      Kostl     = kostl;
      Prctr     = prctr;
      Saknr     = saknr;
      MatStatus = mat_status;
      CreatedBy = created_by;
      CreatedAt = created_at;
      ChangedBy = changed_by;
      ChangedAt = changed_at;
    }
}

define behavior for ZI_ReingCTOpType2 alias OpType
persistent table zreing_ct2_opt_a
draft table zreing_ct2_opt_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( numbering : managed, readonly ) OpUuid;
  field ( readonly ) CtUuid;
  field ( readonly ) MatUuid;
  field ( readonly : update ) OpType;
  field ( readonly ) OpInstanceNum;
  field ( readonly ) ParentInstanceId;
  field ( readonly ) TotalPct;
  field ( readonly ) OpStatus;
  field ( readonly ) OpSubtype;
  field ( readonly ) ExchRate;
  field ( readonly ) OpTypeDescr;
  field ( readonly ) ExchRateDescr;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;
  field ( features : instance ) Installments;
  field ( features : instance ) ExchRateType;
  field ( features : instance ) DeferFrom;
  field ( features : instance ) DeferTo;
  field ( features : instance ) DistType;
  field ( features : instance ) Waers;

  // MePeriodOffset: obligatorio. El dominio es CHAR(2) (no NUMC) justamente para
  // que '00' (periodo M) sea un valor real y distinguible del inicial (espacios);
  // con NUMC, '00' era el valor inicial y el chequeo mandatory de RAP lo rechazaba
  // como campo vacio, impidiendo grabarlo.
  field ( mandatory ) MePeriodOffset;

  // Mod 31.08.2026 EXT_AGFAGINA: se agrega field OpInstanceNum al trigger.
  // El hijo se crea con la instancia del padre; si la determinacion corre antes
  // que DetermineOpInstanceNum, la instancia todavia no esta y el metodo sale sin
  // crear nada. Este trigger lo vuelve a disparar cuando la instancia ya existe.
  // Mod 01.09.2026 EXT_AGFAGINA: se agregan DeferFrom / DeferTo / DistType /
  // Installments al trigger. El hijo nace junto con el padre, cuando el padre
  // todavia no tiene esos datos cargados. Con estos triggers, cuando el usuario
  // los completa o los cambia en el padre, la determinacion vuelve a correr y se
  // los propaga al hijo; al recibirlos, el hijo dispara su propio
  // GenerateCronLines y arma su cronograma.
  determination AutoCreateLinkedOpType on modify { create; field OpType; field ExchRateType; field OpInstanceNum; field DeferFrom; field DeferTo; field DistType; field Installments; }
  determination DetermineOpInstanceNum on modify { create; field OpType; }
  determination SetOpTypeWaers on modify { create; }
  determination CalcInstallments on modify { create; field DeferFrom; field DeferTo; field DistType; }
  // V001 (CC) - #111: retry derived rows when the operation instance becomes available.
  determination GenerateCronLines on modify { create; field DeferFrom; field DeferTo; field DistType; field OpInstanceNum; }
  determination SyncOpRates on modify { create; field ExchRateType; field OpInstanceNum; }
  determination SetOpTypeDescr on modify { create; field OpType; field ExchRateType; }
  determination SetMePeriodOffsetDefault on modify { create; }
  determination SetExchRateTypeDefault on modify { create; field OpType; }
  validation ValidateOpTypeFields on save { create; update; }
  validation ValidateManualRates on save { create; update; }
  validation ValidateMePeriodOffset on save { create; update; }

  association _Material { with draft; }
  association _Contract { with draft; }
  association _Cron { create ( features : instance ); with draft; }
  association _OpRates { create; with draft; }

  // Begin Mod 31.08.2026 EXT_AGFAGINA - Cuotas quedaba en blanco en pantalla.
  // CalcInstallments y GenerateCronLines ya calculaban bien: verificado en la
  // draft, un A con 01.08.2026-31.10.2026 y distribucion L quedaba con
  // INSTALLMENTS = 003 y su cronograma de 3 lineas. Lo que faltaba era declarar
  // los side effects, asi que Fiori Elements no recargaba los campos que las
  // determinaciones escriben y el usuario veia Cuotas vacio.
  side effects
  {
    field DeferFrom affects field Installments, field TotalPct, entity _Cron;
    field DeferTo   affects field Installments, field TotalPct, entity _Cron;
    field DistType  affects field Installments, field TotalPct, entity _Cron;
  }
  // End Mod 31.08.2026 EXT_AGFAGINA

  mapping for zreing_ct2_opt_a corresponding
    {
      CtUuid         = ct_uuid;
      MatUuid        = mat_uuid;
      OpType         = op_type;
      OpUuid         = op_uuid;
      OpInstanceNum  = op_instance_num;
      ParentInstanceId = parent_instance_id;
      ExchRateType   = exch_rate_type;
      OpSubtype      = op_subtype;
      DeferFrom      = defer_from;
      DeferTo        = defer_to;
      DistType       = dist_type;
      MePeriodOffset = me_period_offset;
      Installments   = installments;
      ExchType       = exch_type;
      ExchRate       = exch_rate;
      Waers          = waers;
      TotalPct       = total_pct;
      OpStatus       = op_status;
      OpTypeDescr    = op_type_descr;
      ExchRateDescr  = exch_rate_descr;
      CreatedBy      = created_by;
      CreatedAt      = created_at;
      ChangedBy      = changed_by;
      ChangedAt      = changed_at;
    }
}

define behavior for ZI_ReingCTOpRate2 alias OpRate
persistent table zreing_ct_o_r_a
draft table zreing_ct2_o_r_d
lock dependent by _Contract
authorization dependent by _Contract
etag master LocalLastChangedAt
// V001 (CC) - #111: derive the rate key before creation, including manual CBA.
early numbering
