      OpUuid             = op_uuid;
      OpInstanceNum      = op_instance_num;
      BukrsRecv          = bukrs_recv;
      ManualExchRate     = manual_exch_rate;
      LocalLastChangedAt = local_last_changed_at;
    }
}

define behavior for ZI_ReingCTCron2 alias Cron
persistent table zreing_ct2_crn_a
draft table zreing_ct2_crn_d
lock dependent by _Contract
authorization dependent by _Contract
etag master ChangedAt
{
  update;
  delete;

  field ( readonly ) CtUuid;
  field ( readonly ) MatUuid;
  field ( readonly ) OpType;
  field ( readonly ) OpUuid;
  field ( readonly ) OpInstanceNum;
  field ( readonly : update ) CronYear;
  field ( readonly : update ) CronMonth;
  field ( readonly ) CronStatus;
  field ( readonly ) CreatedBy;
  field ( readonly ) CreatedAt;
  field ( readonly ) ChangedBy;
  field ( readonly ) ChangedAt;

  determination SetCronStatus on modify { create; }
  // V001 (CC) - #111: resolve the exact option identity for manual and generated rows.
  determination SetCronInstance on modify { create; field Percentage; }
  validation ValidateCronInstance on save { create; update; }
  validation ValidateCronSum on save { create; update; }
  // Mod 01.09.2026 EXT_AGFAGINA: propaga el cronograma del padre al hijo cuando
  // se carga a mano (distribucion distinta de Lineal). Con distribucion Lineal no
  // hace falta: el hijo lo genera solo via GenerateCronLines.
  determination SyncChildCron on save { create; update; delete; }

  association _OpType { with draft; }
  association _Contract { with draft; }

  mapping for zreing_ct2_crn_a corresponding
    {
      CtUuid     = ct_uuid;
      MatUuid    = mat_uuid;
      OpType     = op_type;
      OpUuid     = op_uuid;
      // V001 (CC) - #111: persist the instance in active and draft schedules.
      OpInstanceNum = op_instance_num;
      CronYear   = cron_year;
      CronMonth  = cron_month;
      Percentage = percentage;
      CronStatus = cron_status;
      CreatedBy  = created_by;
      CreatedAt  = created_at;
      ChangedBy  = changed_by;
      ChangedAt  = changed_at;
    }
}

