     <HEAD>
      <TDOBJECT>DOKU</TDOBJECT>
      <TDNAME>ZT2_WT_WITHCD</TDNAME>
      <TDID>DE</TDID>
      <TDSPRAS>S</TDSPRAS>
      <TDFORM>S_DOCU_SHOW</TDFORM>
      <TDSTYLE>S_DOCUS1</TDSTYLE>
      <TDVERSION>00003</TDVERSION>
      <TDLINESIZE>072</TDLINESIZE>
     </HEAD>
     <LINES>
      <TLINE>
       <TDFORMAT>U1</TDFORMAT>
       <TDLINE>&amp;DEFINITION&amp;</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>A un tipo de retención de impuestos están asignados uno o varios</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>&quot;Indicadores de retención&quot; que, entre otros, establecen diferentes</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>porcentajes para los tipos de retención.</TDLINE>
      </TLINE>
      <TLINE>
       <TDFORMAT>AS</TDFORMAT>
       <TDLINE>Cabe tener en cuenta que en una operación contable sólo puede</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>adjudicarse &lt;ZH&gt;un&lt;/&gt; indicador de retención por tipo de retención. En</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>caso de que la operación contable cuente con varios impuestos</TDLINE>
      </TLINE>
      <TLINE>
       <TDLINE>simultáneamente, éstos deberán reproducirse mediante diferentes tipos.</TDLINE>
      </TLINE>
     </LINES>
    </item>
