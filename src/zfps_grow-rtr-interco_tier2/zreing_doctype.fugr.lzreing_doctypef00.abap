*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZREING_DOCTP_C_V................................*
FORM GET_DATA_ZREING_DOCTP_C_V.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZREING_DOCTYPE_C WHERE
(VIM_WHERETAB) .
    CLEAR ZREING_DOCTP_C_V .
ZREING_DOCTP_C_V-MANDT =
ZREING_DOCTYPE_C-MANDT .
ZREING_DOCTP_C_V-DOC_TYPE_CODE =
ZREING_DOCTYPE_C-DOC_TYPE_CODE .
ZREING_DOCTP_C_V-PROCESSING_CLASS =
ZREING_DOCTYPE_C-PROCESSING_CLASS .
ZREING_DOCTP_C_V-DESCRIPTION =
ZREING_DOCTYPE_C-DESCRIPTION .
<VIM_TOTAL_STRUC> = ZREING_DOCTP_C_V.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZREING_DOCTP_C_V .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZREING_DOCTP_C_V.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZREING_DOCTP_C_V-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZREING_DOCTYPE_C WHERE
  DOC_TYPE_CODE = ZREING_DOCTP_C_V-DOC_TYPE_CODE .
    IF SY-SUBRC = 0.
    DELETE ZREING_DOCTYPE_C .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZREING_DOCTYPE_C WHERE
  DOC_TYPE_CODE = ZREING_DOCTP_C_V-DOC_TYPE_CODE .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZREING_DOCTYPE_C.
    ENDIF.
ZREING_DOCTYPE_C-MANDT =
ZREING_DOCTP_C_V-MANDT .
ZREING_DOCTYPE_C-DOC_TYPE_CODE =
ZREING_DOCTP_C_V-DOC_TYPE_CODE .
ZREING_DOCTYPE_C-PROCESSING_CLASS =
ZREING_DOCTP_C_V-PROCESSING_CLASS .
ZREING_DOCTYPE_C-DESCRIPTION =
ZREING_DOCTP_C_V-DESCRIPTION .
    IF SY-SUBRC = 0.
    UPDATE ZREING_DOCTYPE_C ##WARN_OK.
    ELSE.
    INSERT ZREING_DOCTYPE_C .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZREING_DOCTP_C_V-UPD_FLAG,
STATUS_ZREING_DOCTP_C_V-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
*---------------------------------------------------------------------*
FORM READ_SINGLE_ZREING_DOCTP_C_V.
  SELECT SINGLE * FROM ZREING_DOCTYPE_C WHERE
DOC_TYPE_CODE = ZREING_DOCTP_C_V-DOC_TYPE_CODE .
ZREING_DOCTP_C_V-MANDT =
ZREING_DOCTYPE_C-MANDT .
ZREING_DOCTP_C_V-DOC_TYPE_CODE =
ZREING_DOCTYPE_C-DOC_TYPE_CODE .
ZREING_DOCTP_C_V-PROCESSING_CLASS =
ZREING_DOCTYPE_C-PROCESSING_CLASS .
ZREING_DOCTP_C_V-DESCRIPTION =
ZREING_DOCTYPE_C-DESCRIPTION .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZREING_DOCTP_C_V USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZREING_DOCTP_C_V-DOC_TYPE_CODE TO
ZREING_DOCTYPE_C-DOC_TYPE_CODE .
MOVE ZREING_DOCTP_C_V-MANDT TO
ZREING_DOCTYPE_C-MANDT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZREING_DOCTYPE_C'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZREING_DOCTYPE_C TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZREING_DOCTYPE_C'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
