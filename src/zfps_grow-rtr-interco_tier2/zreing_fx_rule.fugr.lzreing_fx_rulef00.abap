*...processing: ZREING_FX_RULE_V................................*
FORM GET_DATA_ZREING_FX_RULE_V.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZREING_FX_RULE_A WHERE
(VIM_WHERETAB) .
    CLEAR ZREING_FX_RULE_V .
ZREING_FX_RULE_V-MANDT =
ZREING_FX_RULE_A-MANDT .
ZREING_FX_RULE_V-FX_RULE_ID =
ZREING_FX_RULE_A-FX_RULE_ID .
ZREING_FX_RULE_V-CT_CURRENCY =
ZREING_FX_RULE_A-CT_CURRENCY .
ZREING_FX_RULE_V-SAME_COUNTRY =
ZREING_FX_RULE_A-SAME_COUNTRY .
ZREING_FX_RULE_V-COUNTRY_PREST =
ZREING_FX_RULE_A-COUNTRY_PREST .
ZREING_FX_RULE_V-COUNTRY_RECV =
ZREING_FX_RULE_A-COUNTRY_RECV .
ZREING_FX_RULE_V-BUKRS_PREST =
ZREING_FX_RULE_A-BUKRS_PREST .
ZREING_FX_RULE_V-BUKRS_RECV =
ZREING_FX_RULE_A-BUKRS_RECV .
ZREING_FX_RULE_V-TRANS_CURRENCY_MODE =
ZREING_FX_RULE_A-TRANS_CURRENCY_MODE .
ZREING_FX_RULE_V-TRANS_CURRENCY_FIXED =
ZREING_FX_RULE_A-TRANS_CURRENCY_FIXED .
<VIM_TOTAL_STRUC> = ZREING_FX_RULE_V.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZREING_FX_RULE_V .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZREING_FX_RULE_V.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZREING_FX_RULE_V-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZREING_FX_RULE_A WHERE
  FX_RULE_ID = ZREING_FX_RULE_V-FX_RULE_ID .
    IF SY-SUBRC = 0.
    DELETE ZREING_FX_RULE_A .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZREING_FX_RULE_A WHERE
  FX_RULE_ID = ZREING_FX_RULE_V-FX_RULE_ID .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZREING_FX_RULE_A.
    ENDIF.
ZREING_FX_RULE_A-MANDT =
ZREING_FX_RULE_V-MANDT .
ZREING_FX_RULE_A-FX_RULE_ID =
ZREING_FX_RULE_V-FX_RULE_ID .
ZREING_FX_RULE_A-CT_CURRENCY =
ZREING_FX_RULE_V-CT_CURRENCY .
ZREING_FX_RULE_A-SAME_COUNTRY =
ZREING_FX_RULE_V-SAME_COUNTRY .
ZREING_FX_RULE_A-COUNTRY_PREST =
ZREING_FX_RULE_V-COUNTRY_PREST .
ZREING_FX_RULE_A-COUNTRY_RECV =
ZREING_FX_RULE_V-COUNTRY_RECV .
ZREING_FX_RULE_A-BUKRS_PREST =
ZREING_FX_RULE_V-BUKRS_PREST .
ZREING_FX_RULE_A-BUKRS_RECV =
ZREING_FX_RULE_V-BUKRS_RECV .
ZREING_FX_RULE_A-TRANS_CURRENCY_MODE =
ZREING_FX_RULE_V-TRANS_CURRENCY_MODE .
ZREING_FX_RULE_A-TRANS_CURRENCY_FIXED =
ZREING_FX_RULE_V-TRANS_CURRENCY_FIXED .
    IF SY-SUBRC = 0.
    UPDATE ZREING_FX_RULE_A ##WARN_OK.
    ELSE.
    INSERT ZREING_FX_RULE_A .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZREING_FX_RULE_V-UPD_FLAG,
STATUS_ZREING_FX_RULE_V-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
