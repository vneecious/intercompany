FORM GET_DATA_ZREING_OP_TYP_CV.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZREING_OP_TYPE_C WHERE
(VIM_WHERETAB) .
    CLEAR ZREING_OP_TYP_CV .
ZREING_OP_TYP_CV-MANDT =
ZREING_OP_TYPE_C-MANDT .
ZREING_OP_TYP_CV-OP_TYPE =
ZREING_OP_TYPE_C-OP_TYPE .
ZREING_OP_TYP_CV-ACTIVE =
ZREING_OP_TYPE_C-ACTIVE .
ZREING_OP_TYP_CV-PERMITE_DELTA =
ZREING_OP_TYPE_C-PERMITE_DELTA .
ZREING_OP_TYP_CV-PERMITE_MULTI =
ZREING_OP_TYPE_C-PERMITE_MULTI .
ZREING_OP_TYP_CV-PARENT_TYPE =
ZREING_OP_TYPE_C-PARENT_TYPE .
ZREING_OP_TYP_CV-CM_LOADABLE =
ZREING_OP_TYPE_C-CM_LOADABLE .
ZREING_OP_TYP_CV-DEFAULT_EXCH_RATE_TYPE =
ZREING_OP_TYPE_C-DEFAULT_EXCH_RATE_TYPE .
ZREING_OP_TYP_CV-AUTO_REVERSAL =
ZREING_OP_TYPE_C-AUTO_REVERSAL .
ZREING_OP_TYP_CV-REVERSAL_REASON =
ZREING_OP_TYPE_C-REVERSAL_REASON .
ZREING_OP_TYP_CV-LOCAL_LAST_CHANGED_AT =
ZREING_OP_TYPE_C-LOCAL_LAST_CHANGED_AT .
<VIM_TOTAL_STRUC> = ZREING_OP_TYP_CV.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZREING_OP_TYP_CV .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZREING_OP_TYP_CV.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZREING_OP_TYP_CV-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZREING_OP_TYPE_C WHERE
  OP_TYPE = ZREING_OP_TYP_CV-OP_TYPE .
    IF SY-SUBRC = 0.
    DELETE ZREING_OP_TYPE_C .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZREING_OP_TYPE_C WHERE
  OP_TYPE = ZREING_OP_TYP_CV-OP_TYPE .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZREING_OP_TYPE_C.
    ENDIF.
ZREING_OP_TYPE_C-MANDT =
ZREING_OP_TYP_CV-MANDT .
ZREING_OP_TYPE_C-OP_TYPE =
ZREING_OP_TYP_CV-OP_TYPE .
ZREING_OP_TYPE_C-ACTIVE =
ZREING_OP_TYP_CV-ACTIVE .
ZREING_OP_TYPE_C-PERMITE_DELTA =
ZREING_OP_TYP_CV-PERMITE_DELTA .
ZREING_OP_TYPE_C-PERMITE_MULTI =
ZREING_OP_TYP_CV-PERMITE_MULTI .
ZREING_OP_TYPE_C-PARENT_TYPE =
ZREING_OP_TYP_CV-PARENT_TYPE .
ZREING_OP_TYPE_C-CM_LOADABLE =
ZREING_OP_TYP_CV-CM_LOADABLE .
ZREING_OP_TYPE_C-DEFAULT_EXCH_RATE_TYPE =
ZREING_OP_TYP_CV-DEFAULT_EXCH_RATE_TYPE .
ZREING_OP_TYPE_C-AUTO_REVERSAL =
ZREING_OP_TYP_CV-AUTO_REVERSAL .
ZREING_OP_TYPE_C-REVERSAL_REASON =
ZREING_OP_TYP_CV-REVERSAL_REASON .
ZREING_OP_TYPE_C-LOCAL_LAST_CHANGED_AT =
ZREING_OP_TYP_CV-LOCAL_LAST_CHANGED_AT .
    IF SY-SUBRC = 0.
    UPDATE ZREING_OP_TYPE_C ##WARN_OK.
    ELSE.
    INSERT ZREING_OP_TYPE_C .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZREING_OP_TYP_CV-UPD_FLAG,
STATUS_ZREING_OP_TYP_CV-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
