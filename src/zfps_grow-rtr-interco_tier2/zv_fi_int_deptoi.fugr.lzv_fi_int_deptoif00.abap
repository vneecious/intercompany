  SELECT SINGLE * FROM ZINT_A_MD_DPI WHERE
DPTO = ZV_FI_INT_DEPTOI-DPTO AND
ITEM = ZV_FI_INT_DEPTOI-ITEM .
ZV_FI_INT_DEPTOI-CLIENT =
ZINT_A_MD_DPI-CLIENT .
ZV_FI_INT_DEPTOI-DPTO =
ZINT_A_MD_DPI-DPTO .
ZV_FI_INT_DEPTOI-ITEM =
ZINT_A_MD_DPI-ITEM .
ZV_FI_INT_DEPTOI-COMPANY_CODE =
ZINT_A_MD_DPI-COMPANY_CODE .
ZV_FI_INT_DEPTOI-PRODUCT =
ZINT_A_MD_DPI-PRODUCT .
ZV_FI_INT_DEPTOI-P_AND_L_ID =
ZINT_A_MD_DPI-P_AND_L_ID .
ZV_FI_INT_DEPTOI-P_AND_L_LEVEL =
ZINT_A_MD_DPI-P_AND_L_LEVEL .
ZV_FI_INT_DEPTOI-PROFIT_CENTER =
ZINT_A_MD_DPI-PROFIT_CENTER .
ENDFORM.
*---------------------------------------------------------------------*
FORM CORR_MAINT_ZV_FI_INT_DEPTOI USING VALUE(CM_ACTION) RC.
  DATA: RETCODE LIKE SY-SUBRC, COUNT TYPE I, TRSP_KEYLEN TYPE SYFLENG.
  FIELD-SYMBOLS: <TAB_KEY_X> TYPE X.
  CLEAR RC.
MOVE ZV_FI_INT_DEPTOI-DPTO TO
ZINT_A_MD_DPI-DPTO .
MOVE ZV_FI_INT_DEPTOI-ITEM TO
ZINT_A_MD_DPI-ITEM .
MOVE ZV_FI_INT_DEPTOI-CLIENT TO
ZINT_A_MD_DPI-CLIENT .
  CORR_KEYTAB             =  E071K.
  CORR_KEYTAB-OBJNAME     = 'ZINT_A_MD_DPI'.
  IF NOT <vim_corr_keyx> IS ASSIGNED.
    ASSIGN CORR_KEYTAB-TABKEY TO <vim_corr_keyx> CASTING.
  ENDIF.
  ASSIGN ZINT_A_MD_DPI TO <TAB_KEY_X> CASTING.
  PERFORM VIM_GET_TRSPKEYLEN
    USING 'ZINT_A_MD_DPI'
    CHANGING TRSP_KEYLEN.
  <VIM_CORR_KEYX>(TRSP_KEYLEN) = <TAB_KEY_X>(TRSP_KEYLEN).
  PERFORM UPDATE_CORR_KEYTAB USING CM_ACTION RETCODE.
  ADD: RETCODE TO RC, 1 TO COUNT.
  IF RC LT COUNT AND CM_ACTION NE PRUEFEN.
    CLEAR RC.
  ENDIF.

ENDFORM.
