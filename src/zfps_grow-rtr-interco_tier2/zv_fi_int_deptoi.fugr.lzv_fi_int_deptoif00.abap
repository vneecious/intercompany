*---------------------------------------------------------------------*
*    view related FORM routines
*---------------------------------------------------------------------*
*...processing: ZV_FI_INT_DEPTOI................................*
FORM GET_DATA_ZV_FI_INT_DEPTOI.
  PERFORM VIM_FILL_WHERETAB.
*.read data from database.............................................*
  REFRESH TOTAL.
  CLEAR   TOTAL.
  SELECT * FROM ZINT_A_MD_DPI WHERE
(VIM_WHERETAB) .
    CLEAR ZV_FI_INT_DEPTOI .
ZV_FI_INT_DEPTOI-CLIENT =
ZINT_A_MD_DPI-CLIENT .
ZV_FI_INT_DEPTOI-DPTO =
ZINT_A_MD_DPI-DPTO .
ZV_FI_INT_DEPTOI-ITEM =
ZINT_A_MD_DPI-ITEM .
ZV_FI_INT_DEPTOI-COMPANY_CODE =
ZINT_A_MD_DPI-COMPANY_CODE .
ZV_FI_INT_DEPTOI-PRODUCT =
ZINT_A_MD_DPI-PRODUCT .
ZV_FI_INT_DEPTOI-P_AND_L_ID =
ZINT_A_MD_DPI-P_AND_L_ID .
ZV_FI_INT_DEPTOI-P_AND_L_LEVEL =
ZINT_A_MD_DPI-P_AND_L_LEVEL .
ZV_FI_INT_DEPTOI-PROFIT_CENTER =
ZINT_A_MD_DPI-PROFIT_CENTER .
<VIM_TOTAL_STRUC> = ZV_FI_INT_DEPTOI.
    APPEND TOTAL.
  ENDSELECT.
  SORT TOTAL BY <VIM_XTOTAL_KEY>.
  <STATUS>-ALR_SORTED = 'R'.
*.check dynamic selectoptions (not in DDIC)...........................*
  IF X_HEADER-SELECTION NE SPACE.
    PERFORM CHECK_DYNAMIC_SELECT_OPTIONS.
  ELSEIF X_HEADER-DELMDTFLAG NE SPACE.
    PERFORM BUILD_MAINKEY_TAB.
  ENDIF.
  REFRESH EXTRACT.
ENDFORM.
*---------------------------------------------------------------------*
FORM DB_UPD_ZV_FI_INT_DEPTOI .
*.process data base updates/inserts/deletes.........................*
LOOP AT TOTAL.
  CHECK <ACTION> NE ORIGINAL.
MOVE <VIM_TOTAL_STRUC> TO ZV_FI_INT_DEPTOI.
  IF <ACTION> = UPDATE_GELOESCHT.
    <ACTION> = GELOESCHT.
  ENDIF.
  CASE <ACTION>.
   WHEN NEUER_GELOESCHT.
IF STATUS_ZV_FI_INT_DEPTOI-ST_DELETE EQ GELOESCHT.
     READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
     IF SY-SUBRC EQ 0.
       DELETE EXTRACT INDEX SY-TABIX.
     ENDIF.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN GELOESCHT.
  SELECT SINGLE FOR UPDATE * FROM ZINT_A_MD_DPI WHERE
  DPTO = ZV_FI_INT_DEPTOI-DPTO AND
  ITEM = ZV_FI_INT_DEPTOI-ITEM .
    IF SY-SUBRC = 0.
    DELETE ZINT_A_MD_DPI .
    ENDIF.
    IF STATUS-DELETE EQ GELOESCHT.
      READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY> BINARY SEARCH.
      DELETE EXTRACT INDEX SY-TABIX.
    ENDIF.
    DELETE TOTAL.
    IF X_HEADER-DELMDTFLAG NE SPACE.
      PERFORM DELETE_FROM_MAINKEY_TAB.
    ENDIF.
   WHEN OTHERS.
  SELECT SINGLE FOR UPDATE * FROM ZINT_A_MD_DPI WHERE
  DPTO = ZV_FI_INT_DEPTOI-DPTO AND
  ITEM = ZV_FI_INT_DEPTOI-ITEM .
    IF SY-SUBRC <> 0.   "insert preprocessing: init WA
      CLEAR ZINT_A_MD_DPI.
    ENDIF.
ZINT_A_MD_DPI-CLIENT =
ZV_FI_INT_DEPTOI-CLIENT .
ZINT_A_MD_DPI-DPTO =
ZV_FI_INT_DEPTOI-DPTO .
ZINT_A_MD_DPI-ITEM =
ZV_FI_INT_DEPTOI-ITEM .
ZINT_A_MD_DPI-COMPANY_CODE =
ZV_FI_INT_DEPTOI-COMPANY_CODE .
ZINT_A_MD_DPI-PRODUCT =
ZV_FI_INT_DEPTOI-PRODUCT .
ZINT_A_MD_DPI-P_AND_L_ID =
ZV_FI_INT_DEPTOI-P_AND_L_ID .
ZINT_A_MD_DPI-P_AND_L_LEVEL =
ZV_FI_INT_DEPTOI-P_AND_L_LEVEL .
ZINT_A_MD_DPI-PROFIT_CENTER =
ZV_FI_INT_DEPTOI-PROFIT_CENTER .
    IF SY-SUBRC = 0.
    UPDATE ZINT_A_MD_DPI ##WARN_OK.
    ELSE.
    INSERT ZINT_A_MD_DPI .
    ENDIF.
    READ TABLE EXTRACT WITH KEY <VIM_XTOTAL_KEY>.
    IF SY-SUBRC EQ 0.
      <XACT> = ORIGINAL.
      MODIFY EXTRACT INDEX SY-TABIX.
    ENDIF.
    <ACTION> = ORIGINAL.
    MODIFY TOTAL.
  ENDCASE.
ENDLOOP.
CLEAR: STATUS_ZV_FI_INT_DEPTOI-UPD_FLAG,
STATUS_ZV_FI_INT_DEPTOI-UPD_CHECKD.
MESSAGE S018(SV).
ENDFORM.
